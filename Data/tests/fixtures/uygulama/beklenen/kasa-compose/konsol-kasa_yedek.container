# Konsol tarafından oluşturuldu; kalıcı kaynak: kasa uygulamasının kaydı.
[Unit]
Description=Konsol uygulaması kasa: yedek
After=network-online.target master-firewall.service
Wants=network-online.target master-firewall.service
Requires=konsol-kasa_kasa.service
After=konsol-kasa_kasa.service

[Container]
ContainerName=kasa_yedek
Image=docker.io/example/kasa-yedek@sha256:76c03e3e53b3837816e3a825365da0c5ff3b7d3fc23358e75f77d7b033f6899e
Pull=never
Network=konsol-kasa.network
Label=io.master-stack.managed=uygulama
Label=io.master-stack.uygulama=kasa
LogDriver=journald
DropCapability=KILL NET_BIND_SERVICE SETFCAP SYS_CHROOT
NoNewPrivileges=true
EnvironmentFile="/etc/master-stack/containers/uygulamalar/kasa/env/yedek.env"
Volume=/var/lib/master-stack/uygulamalar/kasa/kasa-data:/data:ro
PodmanArgs=--network-alias=yedek
PodmanArgs=--cpus=0.25
PodmanArgs=--memory=134217728

[Service]
Restart=always
RestartSec=10s
TimeoutStartSec=180
TimeoutStopSec=75
UMask=0077
ExecStartPre=/usr/bin/python3 "/usr/local/sbin/master_container_network.py" --state "/etc/master-stack/state.env" --check

[Install]
WantedBy=multi-user.target
