[Unit]
Description=Konsol WireGuard and system backend (master-stack, DD-133, DD-140)
# DD-180: ağ portu yok; yalnız Unix soketi (0660, root ve Caddy grubu). Tailnet'e Caddy açar
# (panel.<alan> altında /api/wg/* ve /api/konsol/*). Değişiklikleri master-wg yapar.
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/python3 __SBIN_DIR__/master-wg-panel serve --listen unix:__WG_PANEL_SOCKET__ --socket-group __CADDY_GROUP__ --state __STATE_FILE__ --master-wg __SBIN_DIR__/master-wg --master-modul __SBIN_DIR__/master-modul
# Soketin klasörü; Caddy geçebilsin diye 0755, soketin kendisi 0660.
RuntimeDirectory=__WG_PANEL_RUNTIME__
RuntimeDirectoryMode=0755
Environment="PANEL_DNS_DEFAULT=__WG_CLIENT_DNS_DEFAULT__"
Environment="PANEL_KEEPALIVE_DEFAULT=__WG_CLIENT_KEEPALIVE_DEFAULT__"
Environment="PANEL_MTU_DEFAULT=__WG_MTU__"
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
# master-wg root ister (wg syncconf, /etc/wireguard). Yazabildiği tek kalıcı yer
# /etc/wireguard; /run (kilit) ProtectSystem=full altında yazılabilir kalır. Klasörü kurulum
# açar (DD-150: WireGuard modülü sonradan kurulur); yine de yoksa Konsol açılır ('-').
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=-/etc/wireguard
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target
