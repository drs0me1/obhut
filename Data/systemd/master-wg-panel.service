[Unit]
Description=Konsol WireGuard and system backend (master-stack, DD-133, DD-140)
# Yalnız 127.0.0.1'i dinler; tailnet'e Caddy açar (panel.<alan> altında /api/wg/*).
# Sayfa dosyalarını dosya arka ucu sunar. Değişiklikleri master-wg yapar.
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/python3 __SBIN_DIR__/master-wg-panel serve --listen 127.0.0.1:__WG_PANEL_PORT__ --state __STATE_FILE__ --auth __WG_PANEL_AUTH_FILE__ --master-wg __SBIN_DIR__/master-wg
Environment="PANEL_DNS_DEFAULT=__WG_CLIENT_DNS_DEFAULT__"
Environment="PANEL_KEEPALIVE_DEFAULT=__WG_CLIENT_KEEPALIVE_DEFAULT__"
Environment="PANEL_MTU_DEFAULT=__WG_MTU__"
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
# master-wg root ister (wg syncconf, /etc/wireguard). Yazabildiği tek kalıcı yer
# /etc/wireguard; /run (kilit) ProtectSystem=full altında yazılabilir kalır.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/wireguard
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target
