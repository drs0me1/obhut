[Unit]
Description=Tailscale UDP GRO forwarding optimization
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=oneshot
ExecStart=__SBIN_DIR__/tailscale-udp-gro
RemainAfterExit=yes
Restart=no
TimeoutStartSec=30s

[Install]
WantedBy=multi-user.target
