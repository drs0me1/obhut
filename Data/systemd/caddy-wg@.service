[Unit]
Description=Caddy for WireGuard interface %i (master-stack, DD-120, DD-136)
# Ağın sunucu adresi yalnız arayüz ayaktayken vardır: onunla kalkar, onunla iner.
Requires=wg-quick@%i.service
After=wg-quick@%i.service
PartOf=wg-quick@%i.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=notify
User=caddy
Group=caddy
# WG_BIND: bu ağın sunucu IPv4'ü; dosyayı ağı kuran master-wg yazar (DD-143).
EnvironmentFile=__WG_CONF_DIR__/caddy-wg-%i.env
ExecStart=/usr/bin/caddy run --config __CADDY_WG_FILE__ --adapter caddyfile
TimeoutStopSec=5s
LimitNOFILE=1048576
PrivateTmp=true
ProtectSystem=full
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target wg-quick@%i.service
