[Unit]
Description=Konsol file backend and page server (master-stack, DD-139, DD-140)
# Yalnız 127.0.0.1'i dinler; tailnet'e Caddy açar (panel.<alan>). Konsol sayfalarını
# bu servis verir ve indirme klasörünün sahibi olarak çalışır.
After=network-online.target
Wants=network-online.target
RequiresMountsFor=__SERVER_ROOT__
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
# DOWNLOADS_UID/GID'nin adı (kurulum bulur ya da girişsiz sistem hesabı açar).
User=__FILES_PANEL_USER__
Group=__FILES_PANEL_GROUP__
ExecStart=/usr/bin/python3 __SBIN_DIR__/master-files-panel serve --listen 127.0.0.1:__FILES_PANEL_PORT__ --root __SERVER_ROOT__ --web __CONSOLE_WEB_DIR__ --auth-credential panel-auth --trash __FILES_PANEL_TRASH__ --share __SHARE_DIR__ --share-credential paylasim-auth --domain=__LOCAL_DOMAIN__ --version=__V2_VERSION__ --temp-dir=__QBITTORRENT_TEMP_DIR__
# Hesap WireGuard paneliyle aynı: root'a özel özet dosyasının kopyası yalnız bu servise açılır.
LoadCredential=panel-auth:__WG_PANEL_AUTH_FILE__
# DD-141: paylaşım hesabının düz kopyası; Konsol adres/kullanıcı/parolayı gösterir.
LoadCredential=paylasim-auth:__SHARE_CRED_FILE__
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0002
# Yazabildiği tek yer indirme klasörü; /etc, /root ve WireGuard anahtarları görünmez ya da salt okunur.
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=__SERVER_ROOT__
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target
