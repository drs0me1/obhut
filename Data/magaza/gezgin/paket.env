# Gezgin paketi (DD-262): dosya yöneticisi. Mağaza motoru (master-modul) bu bildirimi okur; adımlar
# kanca dosyasındadır. Tabandaki Podman'da konteyner olarak çalışır: birimi gezgin.container (quadlet),
# imajı gezgin.env'deki özetiyle sabit GEZGIN_IMAGE. Gezgin'in kendi girişi vardır; Konsol'un oturumu
# onu açmaz (Gezgin vekil kimlik doğrulamasını bilerek taşımaz).
PAKET_AD="Gezgin"
PAKET_SIRA=30
PAKET_CALISMA=konteyner
PAKET_DURDURULABILIR=1
# DD-210: Konsol'daki kurulum penceresi (ilk yönetici). Taban kurmadan önce bu çalışanla (kur-hazirla)
# doğrular ve parolanın yalnız özetini tohuma yazar; kanca onu konteynerin ilk açılışından önce verir.
PAKET_KUR_AYAR="ayar.py"
# Podman sayfasının uyarlayıcısı: yaşam döngüsü ve onaylı imaj güncellemesi; düzenlenecek alan yok.
PAKET_KONTEYNER_YONETIM="ayar.py"
# DD-214: Konsol'da onaylanan imaj güncellemesi kalıcı seçimdir (kurulum şablonları ondan doldurur).
PAKET_AYAR_ANAHTARLAR="GEZGIN_IMAGE"
PAKET_APT=""
PAKET_ARACLAR=""
PAKET_EKLER=""
PAKET_KONTEYNER="gezgin.container"
# DD-217: konteynerin kendi köprü ağı; arayüz yalnız 127.0.0.1'de, başka port yok.
PAKET_KONTEYNER_AG="__GEZGIN_NETWORK__"
PAKET_IMAJ="__GEZGIN_IMAGE__"
# DD-214: imajın izlediği kanal (hareketli etiket). Konsol yalnız denetler; güncelleme açık istektir.
PAKET_IMAJ_KANAL="__GEZGIN_IMAGE_KANAL__"
PAKET_ADLAR=1
PAKET_GUNLUK=""
PAKET_KUR_ADIM=4
# DD-199: Ayarlar → Caddy yayın satırı. Upstream yalnız loopback olabilir; denetim modülü Gezgin'in
# kendi girişini şart koşar.
PAKET_YAYIN=1
PAKET_YAYIN_AD="Gezgin"
PAKET_YAYIN_YEREL="gezgin"
PAKET_YAYIN_UPSTREAM="127.0.0.1:__GEZGIN_UI_PORT__"
PAKET_YAYIN_PORT_ANAHTARI="GEZGIN_UI_PORT"
PAKET_YAYIN_DENETIM="yayin.py"
PAKET_UYGULA_HEP=0
# DD-200: App Store metinleri ve kurulum penceresi. Sayfa ve API modülü yok: Gezgin kendi arayüzünde
# yönetilir; Konsol onu yeni sekmede açar.
PAKET_KONSOL="konsol.json"
# DD-198/203: Ayarlar port kataloğu satırı.
PAKET_PORTLAR="GEZGIN_UI_PORT:tcp:loopback:Gezgin arayüzü"
# DD-203: Gezgin'in kullanıcı alanının kökünde kendine ayırdığı klasörler (çöp, süren yüklemeler, arşiv
# işleri). Dosyalar seçtirmez/paylaştırmaz, WebDAV gizler, paylaşım açılamaz.
PAKET_KLASORLER="__SERVER_ROOT__/.gezgin-cop __SERVER_ROOT__/.gezgin-yukleme __SERVER_ROOT__/.gezgin-arsiv"
