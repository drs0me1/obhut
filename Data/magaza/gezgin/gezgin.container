# Gezgin paketi (DD-262): Podman birimi (quadlet). master-modul KONTEYNER_BIRIM_DIR altına koyar,
# systemd'nin Podman üreticisi __GEZGIN_CONTAINER__.service birimini yazar. İmaj yalnız özetiyle sabittir
# ve kurulumda bir kez çekilir; açılışta ağa çıkılmaz (Pull=never).
# DD-217: konteyner kendi köprü ağındadır (__GEZGIN_NETWORK__); arayüz yalnız 127.0.0.1'de yayımlanır
# (Caddy ve yayın oraya gider). DD-264: WebDAV paylaşımlarının portu yalnız Tailscale adresinde
# yayımlanır (konteyner koruması bu satırı geçirir); WAN'da ya da başka adreste port yoktur. Adres
# (@TAILSCALE_IPV4@) birim her konduğunda state.env'deki şimdiki adresle dolar (master-modul).
# DD-227: süreç Dosyalar hesabı olarak çalışır (__DOWNLOADS_UID__:__DOWNLOADS_GID__), bütün yetkileri düşürülmüştür;
# dosyalar Konsol ve Paylaşım'la aynı sahipte doğar. Kullanıcı alanı tek parça bağlanır: Gezgin'in çöpü
# ve süren yüklemeleri kökteki kendi klasörlerinde, aynı dosya sisteminde taşınır. Konsol'un çöpü
# konteynerde boş, salt okunur bir klasörle örtülür; Gezgin onu göremez ve yazamaz.
# İlk açılışın yönetici hesabı (kurulum penceresinden, parolanın yalnız bcrypt özeti) ilk.env'dedir;
# veritabanı oluşunca kanca dosyayı boşaltır. Podman dosyayı kendisi okur: değerler genişletilmez.
# DD-223: konteyner güvenlik duvarından sonra açılır ama onunla birlikte yeniden başlamaz (Requires= yok).
[Unit]
Description=Gezgin (Podman)
Wants=network-online.target master-firewall.service
After=network-online.target master-firewall.service

[Container]
Image=__GEZGIN_IMAGE__
ContainerName=__GEZGIN_CONTAINER__
Pull=never
Network=__GEZGIN_NETWORK__
PublishPort=127.0.0.1:__GEZGIN_UI_PORT__:8080/tcp
PublishPort=@TAILSCALE_IPV4@:__GEZGIN_WEBDAV_PORT__:__GEZGIN_WEBDAV_PORT__/tcp
LogDriver=journald
StopTimeout=20
User=__DOWNLOADS_UID__
Group=__DOWNLOADS_GID__
DropCapability=all
NoNewPrivileges=true
PodmanArgs=--umask=0002
Environment=TZ=__TIMEZONE__
Environment=GEZGIN_WEBDAV_PORT=__GEZGIN_WEBDAV_PORT__
EnvironmentFile=__GEZGIN_DATA_DIR__/ilk.env
Volume=__GEZGIN_DATA_DIR__/database:/database
Volume=__GEZGIN_DATA_DIR__/config:/config
Volume=__SERVER_ROOT__:/srv
Volume=__GEZGIN_DATA_DIR__/bos:/srv/__FILES_PANEL_TRASH__:ro

[Service]
ExecStartPre=/usr/bin/python3 __SBIN_DIR__/master_container_network.py --state __STATE_FILE__ --check
Restart=on-failure
RestartSec=10s
TimeoutStartSec=300
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
