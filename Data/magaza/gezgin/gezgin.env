# Gezgin paketinin kendi ayarları (DD-203, DD-262). Kurulum bu dosyayı paket klasörüne kopyalar ve
# paketin şablonlarındaki __GEZGIN_*__ yer tutucularını buradan doldurur; kanca, ayar.py ve yayin.py
# onu okur. Taban (defaults.env/state.env) bu anahtarları taşımaz.
# Arayüz yalnız 127.0.0.1'de yayımlanır; tailnet'ten erişim Caddy üzerinden (gezgin.<alan>).
# DD-219: 610xx bloğundan uzak, bilinen hizmetlerle çakışmayan sabit seyrek port; Linux'un giden
# bağlantı aralığının (32768–60999) dışında.
GEZGIN_UI_PORT=62983
# DD-264: Gezgin'in WebDAV paylaşımları (Finder, Infuse). Konteyner içinde de aynı port: Gezgin paylaşımın
# adresini açıldığı adla bu porttan yazar (http://gezgin.<alan>:PORT/<paylaşım>/). Yalnız Tailscale
# adresinde yayımlanır; WAN'da yoktur.
GEZGIN_WEBDAV_PORT=62984
# DD-217: konteynerin kendi köprü ağı (adı; köprüsü Konsol korumasının önekiyle).
GEZGIN_NETWORK=gezgin
# Uygulama verisi: database (kullanıcılar, ayarlar, bağlantı paylaşımları, giriş günlüğü), config
# (varsayılan ayar dosyası) ve ilk açılışın hesabı (ilk.env). Dosyalar hesabına aittir; `kaldir --veri` siler.
GEZGIN_DATA_DIR=/var/lib/gezgin
# DD-209: konteynerin adı (birimi AD.service) ve imajı. İmaj yalnız özetiyle yazılır (çoklu mimari
# dizini: amd64 ve arm64); bu, temiz kurulumun test edilmiş sürümüdür. DD-214: Konsol, kanalın
# (GEZGIN_IMAGE_KANAL, 1.0 serisi) şu an gösterdiği özeti denetler; operatör onaylarsa yeni özet kalıcı
# seçim olur (package-overrides) ve Quadlet dosyası onu gösterir. Kendiliğinden güncelleme yoktur.
# GEZGIN_SURUM yalnız App Store metnidir.
GEZGIN_CONTAINER=gezgin
GEZGIN_SURUM=1.0.0
GEZGIN_IMAGE=ghcr.io/drs0me1/gezgin@sha256:e767dc749b2cdd545f3e17011aceda5b16aa60cafcaeac56cf35bc86d08508ef
GEZGIN_IMAGE_KANAL=ghcr.io/drs0me1/gezgin:1.0
