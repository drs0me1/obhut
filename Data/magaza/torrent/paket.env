# qBittorrent paketi (DD-151, DD-197). Mağaza motoru (master-modul) bu bildirimi okur;
# adımlar kanca dosyasındadır. Yalnız PAKET_* anahtarları; değerler tırnaklı ya da düz.
PAKET_AD="qBittorrent"
PAKET_SIRA=20
PAKET_CALISMA=host
PAKET_DURDURULABILIR=1
PAKET_HESAP=1
PAKET_APT="qbittorrent-nox"
PAKET_ARACLAR=""
PAKET_EKLER="master-stack.conf:qbittorrent-nox@.service.d/master-stack.conf"
PAKET_ADLAR=1
PAKET_GUNLUK=""
PAKET_KUR_ADIM=4
PAKET_YAYIN=1
PAKET_UYGULA_HEP=0
