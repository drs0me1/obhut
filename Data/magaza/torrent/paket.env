# qBittorrent paketi (DD-151, DD-197). Mağaza motoru (master-modul) bu bildirimi okur;
# adımlar kanca dosyasındadır. Yalnız PAKET_* anahtarları; değerler tırnaklı ya da düz.
PAKET_AD="qBittorrent"
PAKET_SIRA=20
PAKET_CALISMA=host
PAKET_DURDURULABILIR=1
PAKET_HESAP=1
PAKET_APT="qbittorrent-nox"
PAKET_ARACLAR=""
PAKET_EKLER="master-stack.conf:qbittorrent-nox@.service.d/master-stack.conf"
PAKET_ADLAR=1
PAKET_GUNLUK=""
PAKET_KUR_ADIM=4
# DD-199: Ayarlar → Caddy yayın satırı. Upstream yalnız loopback olabilir; denetim modülü bu
# klasördedir ve uygulamanın kendi girişini şart koşar.
PAKET_YAYIN=1
PAKET_YAYIN_AD="qBittorrent"
PAKET_YAYIN_YEREL="torrent"
PAKET_YAYIN_UPSTREAM="127.0.0.1:__TORRENT_UI_PORT__"
PAKET_YAYIN_DENETIM="yayin.py"
PAKET_UYGULA_HEP=0
# DD-198: Ayarlar port kataloğu satırı: state anahtarı, protokol, kapsam, ad (";" ile birden çok).
PAKET_PORTLAR="TORRENT_UI_PORT:tcp:loopback:qBittorrent arayüzü"
