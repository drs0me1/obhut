# qBittorrent paketinin kendi ayarları (DD-203). Kurulum bu dosyayı paket klasörüne kopyalar ve
# paketin şablonlarındaki __TORRENT_*__ yer tutucularını buradan doldurur; kanca, api.py,
# ayar.py, yayin.py ve klasorler.py onu okur. Taban (defaults.env/state.env) bu anahtarları taşımaz.
# Web arayüzü yalnız 127.0.0.1'de dinler; tailnet'ten erişim Caddy üzerinden (torrent.<alan>).
TORRENT_UI_PORT=61006
# Profil (ayarlar, torrent listesi); indirme hesabına aittir, `kaldir --veri` siler.
TORRENT_PROFILE_DIR=/var/lib/qbittorrent
