# WireGuard paketi (DD-150, DD-196, DD-197). Mağaza motoru (master-modul) bu bildirimi okur;
# adımlar kanca dosyasındadır. Yalnız PAKET_* anahtarları; değerler tırnaklı ya da düz.
PAKET_AD="WireGuard"
PAKET_SIRA=10
PAKET_CALISMA=konsol
PAKET_DURDURULABILIR=0
PAKET_HESAP=0
PAKET_APT="wireguard-tools qrencode"
PAKET_ARACLAR="master-wg"
PAKET_EKLER="wg-quick-master-stack.conf:wg-quick@.service.d/master-stack.conf"
PAKET_ADLAR=0
PAKET_GUNLUK="wg-quick@*"
PAKET_KUR_ADIM=5
PAKET_UYGULA_HEP=1
PAKET_UYGULA_NEDEN="paketler, çekirdek modülü, ağlar"
