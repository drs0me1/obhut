#!/usr/bin/env bash
# Tailscale adres değişince state.env güncelle; yalnız Caddy restart.
# Modül siteleri (ör. Paylaşım'ın Infuse adresi {$TAILSCALE_IPV4}:port) Caddyfile'a içe
# aktarılır; Caddy yeniden başlayınca onlar da yeni adresle açılır (DD-98, DD-149).
# dnsmasq / firewall / Compose'a dokunmaz.
set -Eeuo pipefail
umask 077

STATE_FILE="${STATE_FILE:-/etc/master-stack/state.env}"
TAILSCALE_IF="${TAILSCALE_IF:-tailscale0}"

die() { printf 'HATA: %s\n' "$*" >&2; exit 1; }

[[ "$(id -u)" == "0" ]] || die "root gerekli"
[[ -r "$STATE_FILE" ]] || die "state.env yok: $STATE_FILE"

# shellcheck source=/dev/null
source "$STATE_FILE"

: "${TAILSCALE_IF:=tailscale0}"

BOUND_UNITS="caddy.service"
FIREWALL_UNIT="master-firewall.service"
FIREWALL_BIN="${FIREWALL_BIN:-/usr/local/sbin/master-firewall}"
# WantedBy=tailscaled tetiklemesi süreç start'ı ile gelir; IP henüz yok olabilir.
# tailscale wait (1.90+) backend + arayüz + IP hazır olana kadar bekler.
WAIT_TIMEOUT="${REFRESH_TAILNET_WAIT_TIMEOUT:-120s}"

warn_if_tailnet_unusable() {
    # Node tailnet'ten silinirse arayüzdeki adres bir süre durur: her unit
    # yeşil kalır, systemctl --failed boş kalır, ama hiçbir tailnet cihazı
    # erişemez. Bu durum bir kez 4 saat sessizce sürdü. Tek satırlık uyarı
    # onu greplenebilir yapar — izleme yığını değil (DD-86).
    # BackendState tek başına yetmez: Running + Online=false da "unusable".
    command -v tailscale >/dev/null 2>&1 || return 0
    local detail=""
    detail="$(
        tailscale status --json 2>/dev/null |
            jq -r 'if (.BackendState == "Running" and .Self.Online == true)
                   then "ok"
                   else
                     "BackendState=\(.BackendState // "unknown") Online=\(.Self.Online // false)"
                   end' 2>/dev/null
    )" || detail=""
    if [[ -n "$detail" && "$detail" != "ok" ]]; then
        printf 'refresh-tailnet: UYARI tailnet kullanılamıyor (%s)\n' \
            "$detail" >&2
    fi
}

restart_bound_units() {
    # systemctl try-restart, failed/inactive bir unit'te HİÇBİR ŞEY yapmaz ve
    # 0 döner — bu yüzden eski "try-restart || restart" kalıbındaki fallback
    # ulaşılamazdı ve failed bir unit adres geri geldiğinde asla toparlanmazdı.
    # restart her iki durumu da kapsar (DD-72).
    local unit
    for unit in $BOUND_UNITS; do
        systemctl restart "$unit" ||
            printf 'refresh-tailnet: %s yeniden başlatılamadı\n' "$unit" >&2
    done
}

recover_failed_bound_units() {
    # Adres değişmediği hâlde unit failed kalmış olabilir: adres geç geldiği
    # için başlangıçta bind edememiş olan Caddy bu durumda kalır ve
    # kendiliğinden dönmez. Zaten çalışan 5 dk'lık timer kurtarma yolu olur;
    # yeni bir watcher veya timer eklenmez.
    local unit
    for unit in $BOUND_UNITS; do
        if systemctl is-failed --quiet "$unit"; then
            printf 'refresh-tailnet: %s failed; yeniden başlatılıyor\n' "$unit"
            systemctl restart "$unit" ||
                printf 'refresh-tailnet: %s kurtarılamadı\n' "$unit" >&2
        fi
    done
}

recover_firewall_if_broken() {
    # Ağ kenarı watchdog'u (DD-94): yalnız firewall unit'i ve kendi zincir
    # invariantları. Container/dosya/image sağlığı kapsam dışı — sözleşme §2'de
    # reddedilen reconcile motoru değil.
    local why="" state=""
    [[ -x "$FIREWALL_BIN" ]] || return 0
    # tailscaled restart'ı ikisini birlikte tetikler; apply sürerken --check
    # geçici olarak fail eder. Bu turu atla, timer 5 dk sonra tekrar bakar.
    state="$(systemctl show -p ActiveState --value "$FIREWALL_UNIT" 2>/dev/null || true)"
    [[ "$state" == "activating" || "$state" == "deactivating" ]] && return 0
    if systemctl is-failed --quiet "$FIREWALL_UNIT"; then
        why="unit failed"
    elif ! "$FIREWALL_BIN" --check >/dev/null 2>&1; then
        why="--check başarısız"
    fi
    [[ -n "$why" ]] || return 0
    printf 'refresh-tailnet: firewall bozuk (%s); yeniden uygulanıyor\n' "$why"
    # start-limit tükenmişse düz restart "repeated too quickly" ile döner.
    systemctl reset-failed "$FIREWALL_UNIT" 2>/dev/null || true
    systemctl restart "$FIREWALL_UNIT" ||
        printf 'refresh-tailnet: firewall yeniden başlatılamadı\n' >&2
}

wait_for_tailscale_ready() {
    command -v tailscale >/dev/null 2>&1 || return 0
    if ! tailscale wait --help >/dev/null 2>&1; then
        printf 'refresh-tailnet: tailscale wait yok; IP yoksa soft-skip\n' >&2
        return 0
    fi
    if tailscale wait --timeout="$WAIT_TIMEOUT"; then
        return 0
    fi
    printf 'refresh-tailnet: tailscale wait zaman aşımı (%s); atlanıyor\n' \
        "$WAIT_TIMEOUT" >&2
    return 1
}

# Tailscale durumundan bağımsız çalışmalı: tailnet çökse de firewall toparlanır.
recover_firewall_if_broken

if ! wait_for_tailscale_ready; then
    exit 0
fi

warn_if_tailnet_unusable

new_v4="$(
    ip -4 -o addr show dev "$TAILSCALE_IF" scope global 2>/dev/null |
        awk 'NR==1 { sub(/\/.*/, "", $4); print $4 }'
)" || new_v4=""
if [[ ! "$new_v4" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    printf 'refresh-tailnet: Tailscale IPv4 yok (%s); atlanıyor\n' "$TAILSCALE_IF"
    exit 0
fi

new_v6="$(
    ip -6 -o addr show dev "$TAILSCALE_IF" scope global 2>/dev/null |
        awk 'NR==1 { sub(/\/.*/, "", $4); print $4 }'
)" || new_v6=""

old_v4="${TAILSCALE_IPV4:-}"
old_v6="${TAILSCALE_IPV6:-}"

if [[ "$new_v4" == "$old_v4" && "$new_v6" == "$old_v6" ]]; then
    printf 'refresh-tailnet: değişiklik yok (%s)\n' "$new_v4"
    recover_failed_bound_units
    exit 0
fi

printf 'refresh-tailnet: %s/%s -> %s/%s\n' \
    "${old_v4:-yok}" "${old_v6:-yok}" "$new_v4" "${new_v6:-yok}"

tmp="$(mktemp "${STATE_FILE%/*}/.state-XXXXXX")"
# shellcheck disable=SC2064
trap 'rm -f -- "$tmp"' EXIT

# Mevcut state satırlarını koru; yalnız TS adreslerini değiştir.
while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
        TAILSCALE_IPV4=*) printf 'TAILSCALE_IPV4=%s\n' "$new_v4" ;;
        TAILSCALE_IPV6=*) printf 'TAILSCALE_IPV6=%s\n' "$new_v6" ;;
        *) printf '%s\n' "$line" ;;
    esac
done <"$STATE_FILE" >"$tmp"

# Anahtar yoksa ekle
grep -q '^TAILSCALE_IPV4=' "$tmp" || printf 'TAILSCALE_IPV4=%s\n' "$new_v4" >>"$tmp"
grep -q '^TAILSCALE_IPV6=' "$tmp" || printf 'TAILSCALE_IPV6=%s\n' "$new_v6" >>"$tmp"

chmod 0600 "$tmp"
mv -f "$tmp" "$STATE_FILE"
trap - EXIT

restart_bound_units

printf 'refresh-tailnet: state.env güncellendi; Caddy yeniden başlatıldı\n'
