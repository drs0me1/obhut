              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erisim"
                }
              }
            }
          },
          "403": {
            "description": "Host, köken ya da X-Konsol denetimi",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Hata"
                }
              }
            }
          }
        }
