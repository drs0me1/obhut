    "/api/konsol/olaylar": {
      "get": {
        "operationId": "olaylar",
        "summary": "Canlı olaylar (Server-Sent Events): değişen konu yeniden gönderilir, 15 sn'de bir yaşam satırı, yaklaşık 10 dakikada bir akış biter ve sayfa yeniden bağlanır",
        "parameters": [
          {
            "name": "X-Konsol",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Başarılı",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Host, köken ya da X-Konsol denetimi",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Hata"
                }
              }
            }
          },
          "503": {
            "description": "Bu kanaldaki akış sınırı dolu; sayfa yenilemeye geçer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Hata"
                }
              }
            }
          }
        },
