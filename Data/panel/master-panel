    def settings_action(self, user, action, data):
        if action == "apply":
            # The worker refuses a change that waits for the timed confirmation from the internet channel (as the plan
            # does); the channel is Caddy's, whatever the body says.
            data["kanal"] = self.channel()
        if action == "confirm":
            data["client"] = self.client()
            # DD-195: Caddy pins Host to panel.<alan>; the name the browser used is
            # X-Forwarded-Host, and the channel says which Caddy site carried it.
            data["host"] = (self.headers.get("X-Forwarded-Host") or self.headers.get("Host") or "").lower()
            data["kanal"] = self.channel()
        # DD-275: a WireGuard action or an access row is named in the audit line (the request's, or the pending
        # change's). An access row's apply, and the rollback of a pending one, may restart a container: their worker
        # gets the longer limit.
        item = data.get("wireguard") or data.get("erisim")
        seconds = master_settings.ERISIM_WORKER_SECONDS if action == "apply" and "erisim" in data else master_settings.WORKER_SECONDS
        if action != "apply":
            try:
                pending = self.panel.pending()["bekleyen"] or {}
            except (master_settings.SettingsError, OSError, ValueError, KeyError, TypeError):
                pending = {}
            item = pending.get("wireguard") or pending.get("erisim")
            if pending.get("erisim") and action == "rollback":
                seconds = master_settings.ERISIM_WORKER_SECONDS
        code, result = self.panel.settings_run(action, data, seconds=seconds)
        self.audit(user, "ayar-" + action, master_settings.audit_detail(item), code == 200)
        self.close_connection = True
        self.json(code, result)

