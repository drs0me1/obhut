    def api_uygulama_kur(self, user, data):
        """With plan: the install's dry run (KurPlani: every check the job makes before its first write, nothing
        written, pulled or created). Without: checks the file and the answers here first (a refusal never reaches the
        worker); the worker checks them again before anything is written."""
        try:
            text = master_applications.checked_text(data["metin"])
            source = master_applications.request_source(data["kaynak"])
            if data.get("plan"):
                self.json(200, self.app_view().install_plan(text, data["yanitlar"], source))
                return
            inspection = master_inspector.inspect(text)
            if inspection["refusals"] or inspection["format"] is None:
                raise master_containers.ContainerError(400, "Dosyada kurulumu durduran satırlar var; önce denetimdekileri giderin.")
            definition, _values, errors = master_inspector.check(inspection, data["yanitlar"])
            if errors:
                raise master_containers.ContainerError(400, "Yanıtlar geçersiz; önce denetleyin: %s" % ", ".join(sorted(errors)[:5]))
            app = definition["name"]
            env = read_env(self.panel.args.state)
            if master_applications.Records(env).exists(app):
                raise master_containers.ContainerError(409, "Bu adla bir uygulama zaten var.")
            # Rebuild phase 4: every Tailscale name of the new rows must be free (a state check by question).
            taken = master_applications.name_errors(env, app, definition)
            if taken:
                raise master_containers.ContainerError(409, "; ".join("%s: %s" % kv for kv in sorted(taken.items())[:3]))
        except APP_ERRORS as err:
            self.error(err.status, str(err))
            return
        self.app_job(user, "uygulama-kur", app, {"metin": text, "yanitlar": data["yanitlar"], "kaynak": source},
                     {"eylem": "kur", "ad": app})

