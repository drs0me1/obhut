        self.wireguard = master_wireguard.WireGuard(
            lambda: read_env(self.args.state), lambda *a, **k: self.run_tool(*a, **k), lambda env: self.ports(env),
            lambda: self.settings_changed(), lambda line: print(line, flush=True))
        # DD-261: the read model starts a stale image-update check (DD-214) in the background.
        self.update_kick_lock = threading.Lock()
        self.update_kick_at = -UPDATE_KICK_SECONDS
        self.events = master_olaylar.Events([
            master_olaylar.Topic("kaynaklar", 2, self.system,
                                 key=lambda v: json.dumps([v.get("sampled_at"), v.get("host"), v.get("version"), v.get("domain")])),
            master_olaylar.Topic("bekleyen", 1, self.pending),
            master_olaylar.Topic("islemler", 2, self.jobs),
            master_olaylar.Topic("saglik", 60, self.health, key=master_olaylar.without("read_at"), slow=True),
        ], limit=STREAM_LIMIT)

    def public_open(self):
        """DD-195: is Konsol published on the internet right now (name, WAN IPv4, account)?
        Read at most every few seconds; a removed account or publication closes the door."""
        now = time.monotonic()
        with self.public_lock:
            at, value = self.public_cache
            if now - at >= PUBLIC_CACHE_SECONDS:
                try:
                    value = master_publications.panel_active(read_env(self.args.state))
                except (OSError, ValueError, KeyError, master_settings.SettingsError):
                    value = False
                self.public_cache = (now, value)
            return value

    def auth(self):
        directory = read_env(self.args.state).get("KONSOL_AUTH_DIR")
        if not directory:
            raise master_auth.AuthError("Konsol hesap ayarı eksik; kurulumu yeniden çalıştırın.", 503)
        return master_auth.Store(directory)

    def sbin(self):
        """The base's tools and workers (master-wg, master-guncelle, master-onar, master_settings.py, …)."""
        return read_env(self.args.state).get("SBIN_DIR", "")

    def settings_changed(self):
        self.settings_cache = (0, None)

    # -- a base tool with this backend's environment: (rc, stdout, the last stderr line without "HATA: ")
    def run_tool(self, argv, binary=False, timeout=120):
        try:
            proc = subprocess.run(list(argv), capture_output=True, timeout=timeout, env=self.env(), stdin=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired) as err:
            return 1, b"" if binary else "", "%s çalıştırılamadı (%s)" % (os.path.basename(str(argv[0])), err.__class__.__name__)
        err_lines = [l for l in proc.stderr.decode("utf-8", "replace").splitlines() if l.strip()]
        message = err_lines[-1] if err_lines else ""
        if message.startswith("HATA: "):
            message = message[6:]
        out = proc.stdout if binary else proc.stdout.decode("utf-8", "replace")
        return proc.returncode, out, message

    def env(self):
        return {"PATH": TOOL_PATH, "LC_ALL": "C.UTF-8"}

    def unit_active(self, unit):
        """`is-active` bitmiş (toplanmış) geçici birimi yüklemeye çalışır ve her sorguda systemd günlüğüne
        "Failed to open /run/systemd/transient/…" yazdırır; list-units yalnız bellekteki birimlere bakar."""
        try:
            proc = subprocess.run(["systemctl", "list-units", "--plain", "--no-legend", "--no-pager",
                                   "--state=active,activating,deactivating,reloading", unit],
                                  timeout=10, env=self.env(), stdin=subprocess.DEVNULL,
                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired):
            return False
        return any(line.split()[:1] == [unit] for line in proc.stdout.decode("utf-8", "replace").splitlines())

    # -- güncelleme (DD-233)
    def update_info(self, force=False):
        env = read_env(self.args.state)
        return dict(self.updates.status(env, self.unit_active(env.get("GUNCELLEME_UNIT", "")), force),
                    uygulamalar=self.app_updates(env))

    def app_updates(self, env):
        """Sistem → Güncellemeler: the applications whose image has an update in the cached check (DD-214), the same
        state the application list shows (master_applications.app_update); each is confirmed on its own page. Reads
        the records only; a stale check starts in the background as the list does. An unreadable record counts as
        no update (the list names it)."""
        names, any_app = [], False
        if env.get("UYGULAMA_STATE_DIR"):
            try:
                records = master_applications.Records(env)
                for app in records.names():
                    any_app = True
                    try:
                        definition = records.load(app)["definition"]
                    except master_container_config.ContainerConfigError:
                        continue
                    if master_applications.app_update(definition, self.containers.update_of(app)) == "yeni":
                        names.append(app)
            except master_container_config.ContainerConfigError:
                pass
        if any_app:
            self.update_check_soon()
        return {"sayi": len(names), "adlar": names, "denetlendi": int(self.containers.update_at) or None}

    def update_start(self, data):
        """Starts master-guncelle for the commit and version the page showed, as its own unit: the
        installer restarts Konsol and Caddy, the run goes on. One run at a time, never beside a
        pending settings change (the installer refuses that too)."""
        env = read_env(self.args.state)
        unit = env.get("GUNCELLEME_UNIT", "")
        if not re.fullmatch(r"[a-z][a-z0-9-]{0,40}\.service", unit):
            raise master_update.UpdateError(503, "Güncelleme kurulu değil; kurulumu terminalden bir kez yeniden çalıştırın.")
        with self.install_lock:
            blocked = ""
            if env.get("SETTINGS_PENDING_FILE") and os.path.exists(env["SETTINGS_PENDING_FILE"]):
                blocked = "Konsol'da bekleyen bir ayar işlemi var; önce onaylayın ya da geri alın."
            commit, version = self.updates.check_start(env, data, self.unit_active(unit), blocked)
            tool = os.path.join(env.get("SBIN_DIR", ""), "master-guncelle")
            argv = ["systemd-run", "--unit=" + unit, "--collect", "--quiet",
                    "--description=Konsol güncellemesi: %s" % version, tool, "uygula", commit, version]
            try:
                proc = subprocess.run(argv, capture_output=True, timeout=20, env=self.env(), stdin=subprocess.DEVNULL)
            except (OSError, subprocess.TimeoutExpired) as err:
                raise master_update.UpdateError(502, "Güncelleme başlatılamadı (%s)." % err.__class__.__name__)
            if proc.returncode != 0:
                lines = [l for l in proc.stderr.decode("utf-8", "replace").splitlines() if l.strip()]
                raise master_update.UpdateError(502, "Güncelleme başlatılamadı: %s" % (lines[-1] if lines else "systemd-run %d" % proc.returncode))
        return version

    # -- denetle ve onar (DD-239)
    def repair_info(self):
        """The last master-onar report and whether its unit runs now. A report left "calisiyor" by a
        unit that is gone (reboot, killed) reads as failed."""
        env = read_env(self.args.state)
        running = self.unit_active(env.get("ONARIM_UNIT", ""))
        report = None
        try:
            raw, _ = master_settings.read_regular(env.get("ONARIM_DURUM_FILE", ""), 65536)
            report = json.loads(raw.decode("utf-8"))
        except (OSError, ValueError, UnicodeDecodeError, KeyError, master_settings.SettingsError):
            report = None
        if not isinstance(report, dict) or not isinstance(report.get("adimlar"), list):
            report = None
        elif report.get("durum") == "calisiyor" and not running:
            report["durum"] = "hata"
            report["yarida"] = True
        if report and isinstance(report.get("bitis"), int):
            with self.health_lock:
                if report["bitis"] > self.health_cache[0]:
                    self.health_cache = (0.0, None)  # show the health after the repair, not before it
        return {"calisiyor": running, "rapor": report, "kurulu": bool(env.get("ONARIM_UNIT"))}

    REPAIR_LOG_SPANS = {"72s": "-72h", "7g": "-7d"}

    def repair_log(self, span):
        """DD-241: master-onar's journal lines (Konsol, SSH, the hourly firewall check's findings) and the
        address refresh's (boot, nightly, Caddy failures), newest last; bounded lines and bytes."""
        since = self.REPAIR_LOG_SPANS.get(span)
        if not since:
            raise master_update.UpdateError(400, "süre 72s ya da 7g olmalı")
        try:
            proc = subprocess.run(["journalctl", "--since", since, "-t", "master-onar", "-t", "refresh-tailnet-config",
                                   "-o", "short-iso", "--no-pager", "-q", "-n", "3000"],
                                  capture_output=True, timeout=20, env=self.env(), stdin=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired) as err:
            raise master_update.UpdateError(502, "Günlük okunamadı (%s)." % err.__class__.__name__)
        if proc.returncode != 0:
            raise master_update.UpdateError(502, "Günlük okunamadı.")
        return proc.stdout[-524288:].decode("utf-8", "replace")

    def running_job(self):
        """The refusal while an application job or the cleanup runs (a repair or a reboot would cut it off); "" when
        none runs."""
        with self.containers.lock:
            running = [j for j in self.containers.jobs.values() if j.get("state") == "running"]
        if not running:
            return ""
        if any(j.get("action") == master_container_manager.CLEANUP_ACTION for j in running):
            return "Temizlik işlemi sürüyor; bitince yeniden deneyin."
        return "Bir uygulama işlemi sürüyor; bitince yeniden deneyin."

    def repair_start(self, kip):
        env = read_env(self.args.state)
        unit = env.get("ONARIM_UNIT", "")
        if not re.fullmatch(r"[a-z][a-z0-9-]{0,40}\.service", unit):
            raise master_update.UpdateError(503, "Onarım kurulu değil; kurulumu terminalden bir kez yeniden çalıştırın.")
        if kip not in ("onar", "denetle"):
            raise master_update.UpdateError(400, "kip onar ya da denetle olmalı")
        with self.install_lock:
            if self.unit_active(unit):
                raise master_update.UpdateError(409, "Onarım zaten sürüyor.")
            if self.unit_active(env.get("GUNCELLEME_UNIT", "") or "-"):
                raise master_update.UpdateError(409, "Güncelleme sürüyor; bitince yeniden deneyin.")
            busy = self.running_job()
            if busy:
                raise master_update.UpdateError(409, busy)
            tool = os.path.join(env.get("SBIN_DIR", ""), "master-onar")
            argv = ["systemd-run", "--unit=" + unit, "--collect", "--quiet",
                    "--description=Konsol: " + ("denetle ve onar" if kip == "onar" else "denetle"),
                    tool, "--kaynak", "konsol"] + (["--denetle"] if kip == "denetle" else [])
            try:
                proc = subprocess.run(argv, capture_output=True, timeout=20, env=self.env(), stdin=subprocess.DEVNULL)
            except (OSError, subprocess.TimeoutExpired) as err:
                raise master_update.UpdateError(502, "Onarım başlatılamadı (%s)." % err.__class__.__name__)
            if proc.returncode != 0:
                lines = [l for l in proc.stderr.decode("utf-8", "replace").splitlines() if l.strip()]
                raise master_update.UpdateError(502, "Onarım başlatılamadı: %s" % (lines[-1] if lines else "systemd-run %d" % proc.returncode))
        with self.health_lock:
            self.health_cache = (0.0, None)  # the next health read shows the result
        return kip

    def reboot_start(self):
        """DD-246: reboot the server from Konsol. Refused beside an update, a repair, an application job or the cleanup
        and while a settings change is being applied; the reboot is a transient timer a few seconds out, so this answer
        still reaches the page."""
        env = read_env(self.args.state)
        with self.install_lock:
            for unit, why in ((env.get("GUNCELLEME_UNIT", ""), "Güncelleme sürüyor"), (env.get("ONARIM_UNIT", ""), "Onarım sürüyor")):
                if unit and self.unit_active(unit):
                    raise master_update.UpdateError(409, why + "; bitince yeniden deneyin.")
            busy = self.running_job()
            if busy:
                raise master_update.UpdateError(409, busy)
            # A change waiting for its confirmation is rolled back after the boot (another boot id); one being applied
            # is not cut off halfway.
            try:
                pending = master_settings.read_json(Path(env["SETTINGS_PENDING_FILE"]), None) if env.get("SETTINGS_PENDING_FILE") else None
            except master_settings.SettingsError as err:
                raise master_update.UpdateError(409, "Bekleyen ayar işlemi okunamadı; sunucu yeniden başlatılmadı.") from err
            if isinstance(pending, dict) and pending.get("phase") == "applying":
                raise master_update.UpdateError(409, "Bir ayar değişikliği uygulanıyor; bitince yeniden deneyin.")
            argv = ["systemd-run", "--unit=" + REBOOT_UNIT, "--collect", "--quiet", "--on-active=%d" % REBOOT_DELAY_SECONDS,
                    "--description=Konsol: yeniden başlat", "systemctl", "reboot"]
            try:
                proc = subprocess.run(argv, capture_output=True, timeout=20, env=self.env(), stdin=subprocess.DEVNULL)
            except (OSError, subprocess.TimeoutExpired) as err:
                raise master_update.UpdateError(502, "Yeniden başlatma istenemedi (%s)." % err.__class__.__name__)
            if proc.returncode != 0:
                # The unit name is taken while an earlier request still waits for its timer.
                lines = [l for l in proc.stderr.decode("utf-8", "replace").splitlines() if l.strip()]
                if self.unit_active(REBOOT_UNIT + ".timer"):
                    raise master_update.UpdateError(409, "Yeniden başlatma zaten istendi.")
                raise master_update.UpdateError(502, "Yeniden başlatma istenemedi: %s" % (lines[-1] if lines else "systemd-run %d" % proc.returncode))
        return REBOOT_DELAY_SECONDS

    def sample_resources_forever(self):
        """Host resource sampling: the CPU and each application's bridge rate."""
        while True:
            try:
                self.sample_system()
                env = read_env(self.args.state)
                self.app_net_sample(env)
            except Exception as err:
                print("panel: sistem ölçülemedi (%s)" % err, flush=True)
            time.sleep(SAMPLE_SECONDS)

    # -- sistem
    def sample_system(self):
        """İşlemci kullanımı: son iki /proc/stat okuması arasındaki yüzde."""
        try:
            with open("/proc/stat", "rb") as fh:
                # guest/guest_nice are already included in user/nice.
                fields = [int(x) for x in fh.readline().split()[1:9]]
            if len(fields) < 4:
                return
        except (OSError, ValueError, IndexError):
            return
        total = sum(fields)
        idle = fields[3] + (fields[4] if len(fields) > 4 else 0)
        previous, self.cpu_prev = self.cpu_prev, (total, idle)
        if previous is None:
            return
        span, span_idle = total - previous[0], idle - previous[1]
        if span <= 0:
            return
        cpu = max(0.0, min(100.0, 100.0 * (span - span_idle) / span))
        with self.sys_lock:
            self.cpu_sample = {"t": int(time.time()), "cpu": round(cpu, 1)}

    # -- ağ (DD-287: each application's bridge; the WAN rate of DD-206 went with Genel Bakış' network card)
    @staticmethod
    def net_counters(iface):
        """Bir arayüzün alınan ve gönderilen bayt sayaçları (çekirdeğin sysfs dosyalarından)."""
        values = []
        for name in ("rx_bytes", "tx_bytes"):
            with open("%s/%s/statistics/%s" % (SYS_NET, iface, name), "rb") as fh:
                values.append(int(fh.read(32).strip()))
        return values

    def app_net_sample(self, env):
        """Each application's rate (bytes/s) from its own bridge, the interface master_generator.interface_name gives,
        read like the WAN's (no command). The counters are the host's view of the bridge: what the host sends into it
        (tx) is what the application receives (indirme), what it receives from it (rx) is what the application sends
        (yukleme). A counter that went back (the bridge was made again) starts over; a missing interface (a stopped
        application) has no rate; an application without a record is forgotten."""
        wanted = {}
        if env.get("UYGULAMA_STATE_DIR"):
            try:
                for app in master_applications.Records(env).names():
                    wanted[app] = master_applications.interface(env, app)
            except master_container_config.ContainerConfigError:
                return
        readings = {}
        for app, iface in wanted.items():
            try:
                readings[app] = (iface, *self.net_counters(iface)) if IFACE_RE.fullmatch(iface) else None
            except (OSError, ValueError):
                readings[app] = None
        mono, now = time.monotonic(), int(time.time())
        with self.net_lock:
            for app in set(self.app_net_prev) | set(self.app_net_last):
                if readings.get(app) is None:
                    self.app_net_prev.pop(app, None)
                    self.app_net_last.pop(app, None)
            for app, reading in readings.items():
                if reading is None:
                    continue
                iface, rx, tx = reading
                prev = self.app_net_prev.get(app)
                if prev is not None and prev[0] == iface:
                    span = mono - prev[1]
                    if span < NET_STEP_SECONDS:
                        continue
                    if rx < prev[2] or tx < prev[3]:
                        self.app_net_last.pop(app, None)
                    elif span <= 3 * max(SAMPLE_SECONDS, NET_STEP_SECONDS):
                        self.app_net_last[app] = {"t": now, "indirme": int((tx - prev[3]) / span),
                                                  "yukleme": int((rx - prev[2]) / span)}
                elif prev is not None:
                    self.app_net_last.pop(app, None)
                self.app_net_prev[app] = (iface, mono, rx, tx)

    def app_rates(self):
        """{app: {"indirme", "yukleme", "toplam"}}: the applications' last rates, none older than NET_WINDOW_SECONDS,
        each with the bridge's counters so far ("toplam": what passed since the bridge came up, the host's view)."""
        now = int(time.time())
        with self.net_lock:
            out = {}
            for app, r in self.app_net_last.items():
                prev = self.app_net_prev.get(app)
                if r["t"] < now - NET_WINDOW_SECONDS or prev is None:
                    continue
                out[app] = {"indirme": r["indirme"], "yukleme": r["yukleme"], "toplam": {"indirme": prev[3], "yukleme": prev[2]}}
            return out

    def meminfo(self):
        info = {}
        try:
            with open("/proc/meminfo", "rb") as fh:
                for line in fh:
                    key, _, rest = line.decode("utf-8", "replace").partition(":")
                    parts = rest.split()
                    if parts and parts[0].isdigit():
                        info[key] = int(parts[0]) * 1024
        except OSError:
            return 0, 0
        total = info.get("MemTotal", 0)
        return total, max(0, total - info.get("MemAvailable", 0))

    def os_name(self):
        try:
            with open("/etc/os-release", encoding="utf-8") as fh:
                for line in fh:
                    key, _, value = line.rstrip("\n").partition("=")
                    if key == "PRETTY_NAME":
                        return value.strip('"')
        except OSError:
            pass
        return "Linux"

    def ports(self, env, networks=()):
        """Kullanımdaki portlar: state.env ve WireGuard'ın ağları; hiçbir yeri taramaz."""
        rows = []
        for net in networks:
            rows.append({"port": net["port"], "proto": "udp", "scope": "internet", "vpn": True,
                         "name": "WireGuard %s%s" % (net["iface"], " · %s" % net["label"] if net.get("label") else "")})
        for key, name, proto, scope in PORT_ROWS:
            port = num_or(env.get(key), 0)
            if port:
                rows.append({"port": port, "proto": proto, "scope": scope, "name": name})
        return rows

    @staticmethod
    def disk(root):
        if not root:
            return None
        try:
            vfs = os.statvfs(root)
        except OSError:
            return None
        return {"total": vfs.f_blocks * vfs.f_frsize, "free": vfs.f_bavail * vfs.f_frsize}

    def system(self):
        env = read_env(self.args.state)
        with self.sys_lock:
            sample = self.cpu_sample
        mem_total, mem_used = self.meminfo()
        try:
            with open("/proc/uptime", "rb") as fh:
                uptime = int(float(fh.read().split()[0]))
        except (OSError, ValueError, IndexError):
            uptime = 0
        return {
            "host": socket.gethostname().split(".")[0],
            "version": env.get("V2_VERSION", ""),
            # DD-260: the version people see; "version" stays the build number.
            "surum": env.get("OBHUT_SURUM", ""),
            "domain": env.get("LOCAL_DOMAIN", ""),
            "os": self.os_name(),
            "kernel": platform.release(),
            "uptime": uptime,
            "cores": os.cpu_count() or 1,
            "read_at": int(time.time()),
            "sampled_at": sample["t"] if sample else None,
            "cpu": sample["cpu"] if sample else None,
            "mem": {"total": mem_total, "used": mem_used},
            "net": {
                "wan": env.get("WAN_IPV4", ""), "wan6": env.get("WAN_IPV6", ""),
                "iface": env.get("WAN_INTERFACE", ""), "tailscale": env.get("TAILSCALE_IPV4", ""),
                "tailscale6": env.get("TAILSCALE_IPV6", ""),
            },
            # Genel Bakış'ın disk ölçüsü: kullanıcı alanının (SERVER_ROOT) diski.
            "root": env.get("SERVER_ROOT", ""),
            "disk": self.disk(env.get("SERVER_ROOT", "")),
        }

    # -- the settings view (DD-155): read-only; changes nothing, reads only when asked
    def firewall_check(self):
        """master-firewall --check: whether the project's chains are as written, and its last line."""
        view = {}
        try:
            proc = subprocess.run(["master-firewall", "--check"], capture_output=True, timeout=30,
                                  env=self.env(), stdin=subprocess.DEVNULL)
