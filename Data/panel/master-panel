    def api_olaylar(self, query):
        """Server-Sent Events. The page reads them with fetch() so the X-Konsol gate stays as it is
        (EventSource cannot send the header). The stream ends after STREAM_SECONDS and the page
        reconnects; an internet session is asked again while it is open (stream_allowed)."""
        channel = self.channel()
        try:
            self.panel.events.subscribe(channel)
        except master_olaylar.TooMany:
            self.error(503, "Bu kanalda çok fazla canlı akış açık; sayfa yenilemeyle güncellenir.")
            return
        try:
            self.close_connection = True
            self.send_response(200)
            for name, value in (("Content-Type", "text/event-stream; charset=utf-8"), ("Cache-Control", "no-store"),
                                ("Content-Security-Policy", CSP), ("X-Content-Type-Options", "nosniff"),
                                ("X-Frame-Options", "DENY"), ("Referrer-Policy", "no-referrer"), ("Connection", "close")):
                self.send_header(name, value)
            self.end_headers()
            if self.command == "HEAD":
                return
            self.wfile.write(b"retry: %d\n\n" % STREAM_RETRY_MS)
            seen, start = 0, time.monotonic()
            end, beat, check = start + STREAM_SECONDS, start + STREAM_HEARTBEAT_SECONDS, start + STREAM_CHECK_SECONDS
            while True:
                seen, batch = self.panel.events.wait(seen, min(beat, end, check) - time.monotonic())
                now = time.monotonic()
                out = "".join(master_olaylar.frame(*item) for item in batch)
                reason = "sure" if now >= end else None
                if reason is None and now >= check:
                    check = now + STREAM_CHECK_SECONDS
                    if not self.stream_allowed():
                        reason = "oturum"
                if reason:
                    out += master_olaylar.frame("kapat", seen, json.dumps({"neden": reason}))
                elif not out and now >= beat:
                    out = ": canli\n\n"
                if out:
                    self.wfile.write(out.encode("utf-8"))
                    beat = now + STREAM_HEARTBEAT_SECONDS
                if reason:
                    return
        except (OSError, ValueError):
            return  # the page went away or stopped reading (socket timeout)
        finally:
            self.panel.events.unsubscribe(channel)

    def stream_allowed(self):
        """Caddy asked for the session once, when the stream began (DD-194). On the internet site the
        stream ends when the publication closes or the session is gone; the tailnet needs neither."""
        if self.channel() != "internet":
            return True
        if not self.panel.public_open():
            return False
        try:
            return bool(self.panel.auth().user_for(self.cookie_token()))
        except (master_auth.AuthError, OSError):
            return False

