    def wireguard_call(self, call, *args):
        """Runs a WireGuard operation with this request's audit; JSON reply, the status of the route."""
        audit = lambda verb, detail, ok: self.audit(self.request_user, "wireguard-" + verb, detail, ok)
        try:
            body = call(*args, audit)
        except master_wireguard.WireGuardError as err:
            self.error(err.status, str(err))
            return
        self.json(self.route.status, body)

    def wireguard_download(self, call):
        audit = lambda verb, detail, ok: self.audit(self.request_user, "wireguard-" + verb, detail, ok)
        try:
            body, ctype, headers = call(self.params["iface"], self.params["name"], audit)
        except master_wireguard.WireGuardError as err:
            self.error(err.status, str(err))
            return
        self.send(200, body, ctype, headers)

