        olduğu gibi; hesap, parola ya da anahtar taşıyan hiçbir dosya okunmaz. "Yenile" önbelleği atlar."""
        now = time.time()
        stamp, data = self.settings_cache
        if not fresh and data is not None and now - stamp < SETTINGS_CACHE_SECONDS:
            return data
        env = read_env(self.args.state)
        try:
            networks = self.net_rows()
        except RuntimeError:
            networks = []
        data = {
            "read_at": int(now), "version": env.get("V2_VERSION", ""), "domain": env.get("LOCAL_DOMAIN", ""),
            "tailscale": env.get("TAILSCALE_IPV4", ""), "tailscale6": env.get("TAILSCALE_IPV6", ""),
            "ts_if": env.get("TAILSCALE_IF", ""),
