                data["manage"] = {"error": str(err) if isinstance(err, master_settings.SettingsError) else "Ayar yönetimi okunamadı; kurulumu yenileyin."}
        self.settings_cache = (now, data)
        return data

    def all_firewall_rules(self, env):
        rows, errors = [], []
        ours = {env.get(k) for k in ("CHAIN_INPUT", "CHAIN_FORWARD", "CHAIN_NAT", "CHAIN_SETTINGS")}
        for family, binary in ((4, "iptables-save"), (6, "ip6tables-save")):
            try:
                p = subprocess.run([binary, "-c"], capture_output=True, timeout=10, env=self.env())
                if p.returncode:
                    raise OSError()
                table, seq = "", {}
                for line in p.stdout.decode("utf-8", "replace").splitlines():
                    if line.startswith("*"):
                        table = line[1:]
                        continue
                    policy = re.fullmatch(r":(\S+) (\S+) \[(\d+):(\d+)\]", line)
                    if policy:
                        chain, action, packets, size = policy.groups()
                        rows.append({"family": family, "table": table, "chain": chain, "position": "—",
                                     "packets": int(packets), "bytes": int(size), "spec": "Politika: " + action if action != "-" else "Özel zincir",
                                     "owner": "Tailscale" if chain.startswith("ts-") else "Konsol" if chain in ours else "Sistem / üçüncü taraf"})
                        continue
                    match = re.match(r"\[(\d+):(\d+)\] -A (\S+) (.*)", line)
                    if match:
                        packets, size, chain, spec = match.groups()
                        seq[(table, chain)] = seq.get((table, chain), 0) + 1
                        rows.append({"family": family, "table": table, "chain": chain, "position": seq[(table, chain)],
                                     "packets": int(packets), "bytes": int(size), "spec": spec,
                                     "owner": "Tailscale" if chain.startswith("ts-") else "Konsol" if chain in ours else "Sistem / üçüncü taraf"})
            except (OSError, subprocess.TimeoutExpired):
                errors.append("IPv%d kuralları okunamadı" % family)
        return {"rows": rows, "errors": errors}

    def listeners(self):
        rows = []
        for family in (4, 6):
            try:
                p = subprocess.run(["ss", "-H", "-lntu", "-" + str(family)], capture_output=True, timeout=10, env=self.env())
                if p.returncode:
                    return None
            except (OSError, subprocess.TimeoutExpired):
                return None
            for line in p.stdout.decode().splitlines():
                f = line.split()
                if len(f) < 5 or f[0] not in ("tcp", "udp"):
                    continue
                addr, _, port = f[4].rpartition(":")
                if port.isdigit():
                    rows.append({"proto": f[0], "family": family, "port": int(port), "address": addr.strip("[]")})
        return rows

    def settings_ports(self, env, networks, listeners=None):
        rows = []
        for p in self.ports(env, networks):
            if p["scope"] == "wireguard":
                continue
            scope = {"internet": "wan", "tailscale": "tail", "loopback": "lo"}[p["scope"]]
            for family in (4, 6):
                for proto in p["proto"].split("+"):
                    rows.append({"name": p["name"], "family": family, "proto": proto, "port": p["port"], "scope": scope,
                                 "baseline": not (family == 6 and p["name"].startswith("WireGuard "))})
                    if scope in ("tail", "lo"):
                        rows.append({"name": p["name"], "family": family, "proto": proto, "port": p["port"], "scope": "wan", "baseline": False})
        for net in networks:
            for family in (4, 6):
                rows.append({"name": "qBittorrent arayüzü", "family": family, "proto": "tcp", "port": int(env["TORRENT_UI_PORT"]),
                             "scope": net["iface"], "baseline": family == 4 and net["scope"] == "ui"})
        seen = {(r["family"], r["proto"], r["port"], r["scope"]) for r in rows}
        for listener in listeners or []:
            for scope in ("wan", "tail", "lo"):
                key = (listener["family"], listener["proto"], listener["port"], scope)
                if key in seen:
                    continue
                seen.add(key)
                rows.append({"name": "Diğer dinleyici", "family": listener["family"], "proto": listener["proto"],
                             "port": listener["port"], "scope": scope, "baseline": scope != "wan"})
        return rows

    def settings_run(self, action, data, shares=False):
        """stdin is private; no password in argv, environment, journal or response."""
        helper = os.path.join(os.path.dirname(self.args.master_modul), "master_shares.py" if shares else "master_settings.py")
        argv = ["systemd-run", "--quiet", "--wait", "--pipe", "--collect",
                "--property=UMask=0077", "--property=RuntimeMaxSec=150",
                "--setenv=PYTHONDONTWRITEBYTECODE=1", "/usr/bin/python3", helper, "--state", self.args.state, action]
        try:
            p = subprocess.run(argv, input=json.dumps(data), capture_output=True, text=True, timeout=155, env=self.env())
            result = json.loads(p.stdout)
            self.settings_cache = (0, None)
            return (400 if p.returncode else 200), result
        except (OSError, subprocess.TimeoutExpired, ValueError):
            if shares:
                return 502, {"error": "İşlem sonucu alınamadı. Tekrar kaydetmeden önce WebDAV listesini yenileyip durumu kontrol edin."}
            return 502, {"error": "İşlem sonucu alınamadı. Ayarlar sayfasını yenileyin; onaysız işlem sunucuda geri alınır."}

    def actions(self):
        """Son işlemler: iki arka ucun audit satırları (journald), yeniden eskiye."""
        now = time.time()
        stamp, rows = self.actions_cache
        if now - stamp < ACTIONS_CACHE_SECONDS:
            return rows
        cmd = ["journalctl", "-u", "master-wg-panel.service", "-u", "master-files-panel.service",
               "--since", "-7 days", "-n", "400", "-o", "short-unix", "--no-pager"]
        try:
            proc = subprocess.run(cmd, capture_output=True, timeout=15, stdin=subprocess.DEVNULL,
                                  env={"PATH": "/usr/bin:/bin", "LC_ALL": "C.UTF-8"})
            lines = proc.stdout.decode("utf-8", "replace").splitlines() if proc.returncode == 0 else []
        except (OSError, subprocess.SubprocessError):
            lines = []
        rows = []
        for line in lines:
            stamp_text, _, rest = line.partition(" ")
            body = rest.partition(": ")[2]
            m = ACTION_RE.match(body.strip())
            if not m:
                continue
            try:
                when = int(float(stamp_text))
            except ValueError:
                continue
            # Dosya arka ucu ayrıntıyı JSON olarak yazar; sayfada tırnaksız görünsün.
            detail = m.group(5)
            if detail.startswith('"') and detail.endswith('"'):
                try:
                    detail = json.loads(detail)
                except ValueError:
                    pass
            rows.append({"at": when, "source": m.group(1), "user": m.group(2), "client": m.group(3),
                         "action": m.group(4), "detail": detail[:200], "ok": m.group(6) == "ok"})
        rows = rows[-ACTIONS_LIMIT:][::-1]
        self.actions_cache = (now, rows)
        return rows

    def wg_on(self, env=None):
        """DD-150: WireGuard bir Konsol modülüdür; kurulu değilken master-wg hiç çağrılmaz."""
        return self.module_state("wireguard", env) == "calisiyor"

    def net_rows(self):
        """master-wg nets satırları (peer listesi olmadan); state ve portlar aynı kaynağı okur."""
        if not self.wg_on():
            return []
        rc, out, message = self.run("nets")
        if rc != 0:
            raise RuntimeError(message or "ağ listesi okunamadı")
        rows = []
        for line in out.splitlines():
            f = line.split("\t")
            if len(f) != 11 or not IFACE_RE.match(f[0]):
                continue
            rows.append({
                "iface": f[0], "port": num_or(f[1], 0), "scope": f[2],
                "server4": f[3], "subnet4": f[4], "server6": f[5], "subnet6": f[6],
                "dns": f[7], "label": f[8], "active": f[9] == "1", "count": num_or(f[10], 0),
            })
        return rows

    def state(self):
        """DD-136: bütün ağlar (wg0 + panelde eklenenler), her biri kendi peer'larıyla."""
        env = read_env(self.args.state)
        networks = self.net_rows()
        seen = set()
        for net in networks:
            net["peers"] = self.peers(net["iface"], seen)
        with self.activity_lock:
            for key in [k for k in self.activity if k not in seen]:
                del self.activity[key]
        return {
            "host": socket.gethostname().split(".")[0],
            "version": env.get("V2_VERSION", ""),
            "endpoint": env.get("WG_ENDPOINT_HOST", ""),
            "max": num_or(env.get("WG_NETWORKS_MAX"), 9) + 1,
            "reserved": sorted({num_or(env.get(k), 0) for k in (
                "SSH_PUBLIC_PORT", "TORRENT_UI_PORT", "TAILSCALE_UDP_PORT", "WG_PANEL_PORT",
                "FILES_PANEL_PORT", "SHARE_PORT")} - {0} | {53, 80}),
            "defaults": {
                "dns": os.environ.get("PANEL_DNS_DEFAULT", "1.1.1.1, 1.0.0.1, 2606:4700:4700::1001"),
                "keepalive": num_or(os.environ.get("PANEL_KEEPALIVE_DEFAULT"), 21),
                "mtu": num_or(os.environ.get("PANEL_MTU_DEFAULT"), 1420),
                # DD-143: ilk ağa önerilen UDP portu; sonrakiler 61020'den sıralanır.
                "port": num_or(env.get("WG_PORT_DEFAULT"), 61001),
            },
            "now": int(time.time()),
            "active_window": int(ACTIVE_WINDOW),
            "installed": self.wg_on(env),
            "networks": networks,
        }


def num_or(value, default):
    return int(value) if value and str(value).isdigit() else default


def mask_profile(text):
    out = []
    for line in text.splitlines():
        key, sep, _ = line.partition(" = ")
        out.append("%s = %s" % (key, MASK) if sep and key in ("PrivateKey", "PresharedKey") else line)
    return "\n".join(out) + "\n"


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "master-wg-panel"
    sys_version = ""
    protocol_version = "HTTP/1.1"
    panel = None

    def log_message(self, fmt, *args):  # isteğin satırı; başlıklar yazılmaz
        sys.stderr.write("panel: %s %s\n" % (self.client(), fmt % args))

    def audit(self, user, action, detail, ok):
        print("panel: %s %s %s %s -> %s" % (user, self.client(), action, detail, "ok" if ok else "hata"), flush=True)

    def client(self):
        peer = self.client_address[0] if self.client_address else "?"
        forwarded = self.headers.get("X-Forwarded-For", "") if self.headers else ""
        if peer in ("127.0.0.1", "::1") and forwarded:
            return forwarded.split(",")[-1].strip()[:64]
        return peer

    # -- yanıt
    def send(self, code, body=b"", ctype="application/json; charset=utf-8", extra=None):
        if isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Security-Policy", CSP)
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Referrer-Policy", "no-referrer")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def json(self, code, obj):
        self.send(code, json.dumps(obj, ensure_ascii=False))

    def error(self, code, message):
        self.json(code, {"error": message})

    # -- kapılar
    def gate(self):
        """Host ve (API için) köken denetimi. İşlemi yapanın günlük adı ya da None (yanıt gönderildi).
        DD-147: parola yok; erişim sınırı Tailscale. Bu iki denetim o yüzden kalır."""
        host = (self.headers.get("Host") or "").lower()
        if host not in self.allowed_hosts():
            self.error(403, "bu adresten erişilemez")
            return None
        if self.path.startswith("/api/"):
            site = self.headers.get("Sec-Fetch-Site")
            if self.headers.get(API_HEADER) != "1" or (site and site not in ("same-origin", "none")):
                self.error(403, "istek reddedildi (yalnız panel sayfasından)")
                return None
        return ACTOR

    def allowed_hosts(self):
        env = read_env(self.panel.args.state)
        port = self.server.server_address[1]
        hosts = {"127.0.0.1:%d" % port, "localhost:%d" % port}
        if env.get("LOCAL_DOMAIN"):
            hosts.add("panel.%s" % env["LOCAL_DOMAIN"].lower())
        hosts.update(h.lower() for h in self.panel.args.allow_host)
        return hosts

    def body_json(self):
        if (self.headers.get("Content-Type") or "").split(";")[0].strip() != "application/json":
            return None
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            return None
        if length <= 0 or length > MAX_BODY:
            return None
        try:
            data = json.loads(self.rfile.read(length).decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            return None
        return data if isinstance(data, dict) else None

    # -- yöntemler
    def do_GET(self):
        user = self.gate()
        if user is None:
            return
        path = urllib.parse.urlsplit(self.path).path
        query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
        if path == "/api/konsol/paylasim":
            try:
                self.json(200, master_shares.Manager(self.panel.args.state).public())
            except (master_shares.ShareError, OSError, ValueError, KeyError):
                self.error(503, "Paylaşım kaydı okunamadı; kurulumu kontrol edin.")
            return
        if path == "/api/wg/state":
            try:
                self.json(200, self.panel.state())
            except RuntimeError as err:
                self.error(502, str(err))
            return
        if path == "/api/wg/sistem":
            try:
                self.json(200, self.panel.system(self.panel.net_rows()))
            except RuntimeError as err:
                self.error(502, str(err))
            return
        if path == "/api/konsol/ayarlar":
            self.json(200, self.panel.settings(fresh="yenile" in query))
            return
        if path in ("/api/konsol/ayarlar/durum", "/api/konsol/ayarlar/klasorler"):
            try:
                manager = master_settings.Manager(self.panel.args.state)
                self.json(200, {"items": manager.folders(query.get("path", [None])[0])} if path.endswith("klasorler") else manager.status())
            except (master_settings.SettingsError, OSError, KeyError, ValueError) as err:
                self.error(400, str(err) if isinstance(err, master_settings.SettingsError) else "Ayarlar okunamadı.")
            return
        if path == "/api/konsol/moduller":
            try:
                self.json(200, {"items": self.panel.modules()})
            except RuntimeError as err:
                self.error(502, str(err))
            return
        m = re.match(r"^/api/konsol/moduller/([a-z]{2,16})/gunluk$", path)
        if m:
            rc, out, message = self.panel.modul("gunluk", m.group(1), "80")
            if rc != 0:
                self.error(404 if "bilinmeyen modül" in message else 502, message or "günlük okunamadı")
                return
            self.send(200, out.encode("utf-8"), "text/plain; charset=utf-8")
            return
        # DD-149: modül hesabı (root'a özel dosyadan). Parola yalnız ?parola=1 ile, açıkça
        # istenince döner ve günlüğe yalnız "gösterildi" olarak geçer; değer hiçbir yere yazılmaz.
        m = re.match(r"^/api/konsol/moduller/([a-z]{2,16})/hesap$", path)
        if m:
            mid = m.group(1)
            if mid not in ACCOUNT_MODULES or not self.panel.module_state(mid):
                self.error(404, "bu modülde hesap yok")
                return
            reveal = query.get("parola") == ["1"]
            rc, out, message = self.panel.modul("hesap", mid, *(["--parola"] if reveal else []))
            fields = out.rstrip("\n").split("\t") if rc == 0 else []
            env = read_env(self.panel.args.state)
            domain = env.get("LOCAL_DOMAIN", "")
            if mid == "torrent":
                # kullanıcı, gecici|ayarli [, geçici parola]: parola arayüzde ayarlandıysa yoktur.
                temp = len(fields) >= 2 and fields[1] == "gecici"
                if len(fields) not in (2, 3) or (reveal and temp and len(fields) != 3):
                    self.error(404, message or "hesap yok")
                    return
                body = {"user": fields[0], "temp": temp, "host": "torrent.%s" % domain if domain else ""}
                if reveal and temp:
                    body["pass"] = fields[2]
                    self.audit(user, "modul-hesap", mid, True)
                self.json(200, body)
                return
        if path == "/api/wg/islemler":
            self.json(200, {"items": self.panel.actions()})
            return
        m = re.match(r"^/api/wg/nets/([^/]+)/peers/([^/]+)/(profile|qr\.png)$", path)
        if m and not self.panel.wg_on():
            self.error(404, "WireGuard modülü kurulu değil")
            return
        if m:
            net, name = self.net_and_name(m.group(1), m.group(2))
            if net is None:
                return
            if m.group(3) == "qr.png":
                rc, out, message = self.panel.run("png", name, binary=True, net=net)
                self.audit(user, "qr", "%s/%s" % (net, name), rc == 0)
                if rc != 0 or not out.startswith(b"\x89PNG"):
                    self.error(404, message or "QR üretilemedi")
                    return
                self.send(200, out, "image/png", {"Content-Disposition": 'attachment; filename="%s.png"' % name})
                return
            rc, out, message = self.panel.run("profile", name, net=net)
            if rc != 0:
                self.error(404, message or "profil yok")
                return
            if query.get("masked") == ["1"]:
                self.send(200, mask_profile(out), "text/plain; charset=utf-8")
                return
            self.audit(user, "profil", "%s/%s" % (net, name), True)
            self.send(200, out, "text/plain; charset=utf-8",
                      {"Content-Disposition": 'attachment; filename="%s.conf"' % name})
            return
        self.error(404, "bulunamadı")

    def do_HEAD(self):
        self.do_GET()

    def net_and_name(self, raw_net, raw_name=None):
        net = urllib.parse.unquote(raw_net)
        if not IFACE_RE.match(net):
            self.error(400, "geçersiz arayüz")
            return None, None
        if raw_name is None:
            return net, None
        name = urllib.parse.unquote(raw_name)
        if not NAME_RE.match(name):
            self.error(400, "geçersiz peer adı")
            return None, None
        return net, name

    def confirmed(self, data):
        if str(data.get("confirm", "")).strip().lower() != CONFIRM_WORD:
            self.error(400, "onay için %s yazın" % CONFIRM_WORD)
            return False
        return True

    def do_POST(self):
        user = self.gate()
        if user is None:
            return
        path = urllib.parse.urlsplit(self.path).path
        data = self.body_json()
        if data is None:
            self.error(400, "istek gövdesi JSON olmalı")
            return
        share_actions = {"kaydet": "save", "durum": "pause", "kaldir": "remove"}
        if path in {"/api/konsol/paylasim/" + name for name in share_actions}:
            code, result = self.panel.settings_run(share_actions[path.rsplit("/", 1)[-1]], data, shares=True)
            self.audit(user, "paylasim-" + share_actions[path.rsplit("/", 1)[-1]], "klasör paylaşımı", code == 200)
            self.close_connection = True
            self.json(code, result)
            return
        actions = {"uygula": "apply", "onayla": "confirm", "geri-al": "rollback"}
        if path in {"/api/konsol/ayarlar/" + name for name in actions}:
            action = actions[path.rsplit("/", 1)[-1]]
            if action == "confirm":
                data["client"] = self.client()
                data["host"] = self.headers.get("Host", "").lower()
            code, result = self.panel.settings_run(action, data)
            self.audit(user, "ayar-" + action, "ayarlar", code == 200)
            self.close_connection = True
            self.json(code, result)
            return
        m = re.match(r"^/api/konsol/moduller/([a-z]{2,16})/(%s)$" % "|".join(MODULE_ACTIONS), path)
        if m:
            mid, action = m.group(1), m.group(2)
            known = [i["id"] for i in self.panel.modules()] if MODULE_ID_RE.match(mid) else []
            if mid not in known:
                self.error(404, "bilinmeyen modül")
                return
            if action == "parola":
                if mid not in PASSWORD_MODULES:
                    self.error(404, "bu modülde parola yok")
                    return
                if not self.panel.module_state(mid):
                    self.error(409, "modül kurulu değil")
                    return
            code, message = self.panel.module_spawn(mid, action, bool(data.get("veri")))
            self.audit(user, "modul-" + action, mid + (" +veri" if action == "kaldir" and data.get("veri") else ""), code == 202)
            if code != 202:
                self.error(code, message)
                return
            self.json(202, {"id": mid, "action": action})
            return
        # DD-150: WireGuard modülü kurulu değilken hiçbir ağ işlemi master-wg'ye gitmez.
        if path.startswith("/api/wg/") and not self.panel.wg_on():
            self.error(409, "WireGuard modülü kurulu değil; Konsol → Modüller'den kurun")
            return
        if path == "/api/wg/nets":
            port = str(data.get("port", "")).strip()
            scope = str(data.get("scope", "")).strip()
            dns = str(data.get("dns", "")).strip()
            label = str(data.get("label", "")).strip()
            if not port.isdigit() or scope not in ("inet", "ui") or not dns:
                self.error(400, "port, erişim (inet | ui) ve DNS gerekli")
                return
            rc, out, message = self.panel.run("net-add", port, scope, dns, label)
            parts = out.strip().split("\t")
            self.audit(user, "ag-ekle", parts[0] if rc == 0 else port, rc == 0)
            if rc != 0:
                self.error(400, message or "ağ eklenemedi")
                return
            self.json(201, {"iface": parts[0], "port": num_or(parts[-1], 0)})
            return
        m = re.match(r"^/api/wg/nets/([^/]+)/(remove|reset|peers|durum)$", path)
        if m:
            net, _ = self.net_and_name(m.group(1))
            if net is None:
                return
            if m.group(2) == "remove":
                if not self.confirmed(data):
                    return
                rc, out, message = self.panel.run("net-remove", net, "--onay")
                self.audit(user, "ag-kaldir", net, rc == 0)
                if rc != 0:
                    self.error(400, message or "ağ kaldırılamadı")
                    return
                parts = out.strip().split("\t")
                self.json(200, {"iface": net, "peers": num_or(parts[-1], 0)})
                return
            if m.group(2) == "durum":
                want = "ac" if data.get("on") else "kapat"
                rc, out, message = self.panel.run("net", want, net=net)
                self.audit(user, "ag-durum", "%s %s" % (net, want), rc == 0)
                if rc != 0:
                    self.error(400, message or "ağ durumu değiştirilemedi")
                    return
                self.json(200, {"iface": net, "active": out.strip().split("\t")[-1] == "1"})
                return
            if m.group(2) == "reset":
                if not self.confirmed(data):
                    return
                rc, out, message = self.panel.run("reset", "--onay", net=net)
                self.audit(user, "yeniden-uret", net, rc == 0)
                if rc != 0:
                    self.error(400, message or "%s yeniden üretilemedi" % net)
                    return
                parts = out.strip().split("\t")
                self.json(200, {"peers": num_or(parts[0], 0), "profiles": num_or(parts[-1], 0)})
                return
            name = str(data.get("name", ""))
            if not NAME_RE.match(name):
                self.error(400, "geçersiz peer adı (harf, rakam, . _ -; en çok 32)")
                return
            dns = str(data.get("dns", "")).strip()
            keepalive = str(data.get("keepalive", "")).strip()
            mtu = str(data.get("mtu", "")).strip()
            if not dns or not keepalive.isdigit() or not mtu.isdigit():
                self.error(400, "DNS, keepalive ve MTU gerekli")
                return
            rc, out, message = self.panel.run("add", name, dns, keepalive, mtu, net=net)
            self.audit(user, "ekle", "%s/%s" % (net, name), rc == 0)
            if rc != 0:
                self.error(400, message or "peer eklenemedi")
                return
            self.json(201, {"name": name, "ipv4": out.strip().split("\t")[-1]})
            return
        m = re.match(r"^/api/wg/nets/([^/]+)/peers/([^/]+)/(remove|dns|keepalive|durum)$", path)
        if m:
            net, name = self.net_and_name(m.group(1), m.group(2))
            if net is None:
                return
            if m.group(3) == "remove":
                rc, out, message = self.panel.run("remove", name, net=net)
                self.audit(user, "cikar", "%s/%s" % (net, name), rc == 0)
            elif m.group(3) == "durum":
                want = "ac" if data.get("on") else "kapat"
                rc, out, message = self.panel.run("peer", name, want, net=net)
                self.audit(user, "peer-durum", "%s/%s %s" % (net, name, want), rc == 0)
            elif m.group(3) == "keepalive":
                keepalive = str(data.get("keepalive", "")).strip()
                if not keepalive.isdigit():
                    self.error(400, "keepalive saniye olarak gerekli (0 = kapalı)")
                    return
                rc, out, message = self.panel.run("keepalive", name, keepalive, net=net)
                self.audit(user, "keepalive", "%s/%s %s" % (net, name, keepalive), rc == 0)
            else:
                dns = str(data.get("dns", "")).strip()
                if not dns:
                    self.error(400, "DNS gerekli")
                    return
                rc, out, message = self.panel.run("dns", name, dns, net=net)
                self.audit(user, "dns", "%s/%s" % (net, name), rc == 0)
            if rc != 0:
                self.error(400, message or "işlem yapılamadı")
                return
            self.json(200, {"ok": True})
            return
        self.error(404, "bulunamadı")


class Server(http.server.ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def cmd_serve(args):
    host, _, port = args.listen.rpartition(":")
    if host != "127.0.0.1" or not port.isdigit():
        fail("panel yalnız yerel adresi dinler (127.0.0.1:PORT)")
    Handler.panel = Panel(args)
    httpd = Server((host, int(port)), Handler)
    threading.Thread(target=Handler.panel.sample_forever, name="sampler", daemon=True).start()
    print("panel: %s:%s dinleniyor" % (host, port), flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass


def main():
    parser = argparse.ArgumentParser(prog="master-wg-panel")
    sub = parser.add_subparsers(dest="cmd")
    s = sub.add_parser("serve")
    s.add_argument("--listen", required=True)
    s.add_argument("--state", required=True)
    s.add_argument("--master-wg", dest="master_wg", required=True)
    s.add_argument("--master-modul", dest="master_modul", required=True)
    s.add_argument("--allow-host", dest="allow_host", action="append", default=[])
    s.add_argument("--state-env", dest="state_env", action="store_true",
                   help="master-wg'ye STATE_FILE olarak --state verilir (test)")
    c = sub.add_parser("check")
    c.add_argument("--url", required=True)
    c.add_argument("--host", required=True)
    args = parser.parse_args()
    if args.cmd == "serve":
        cmd_serve(args)
    elif args.cmd == "check":
        cmd_check(args)
    else:
        parser.print_usage()
        sys.exit(2)


if __name__ == "__main__":
    main()
