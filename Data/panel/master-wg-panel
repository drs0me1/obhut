def own_address(ip):
    """Sunucunun kendi adresi mi? Sıradan bir soket yalnız yerel bir adrese bağlanabilir.
    Yalnız "adres yerel değil" (EADDRNOTAVAIL) dışarıdan sayılır; başka her hata (port ya da
    dosya tanıtıcısı tükenmesi) isteği reddettirir. Port ayrılmaz: IP_BIND_ADDRESS_NO_PORT."""
    if ip.is_loopback or ip.is_link_local or ip.is_unspecified:
        return True
    try:
        with socket.socket(socket.AF_INET6 if ip.version == 6 else socket.AF_INET, socket.SOCK_STREAM) as probe:
            with contextlib.suppress(OSError):
                probe.setsockopt(socket.IPPROTO_IP, getattr(socket, "IP_BIND_ADDRESS_NO_PORT", 24), 1)
            probe.bind((str(ip), 0))
    except OSError as err:
        return err.errno != errno.EADDRNOTAVAIL
    return True


def remote_tailnet(value):
    try:
        ip = ipaddress.ip_address(value)
    except ValueError:
        return False
    ip = getattr(ip, "ipv4_mapped", None) or ip
    return any(ip in net for net in TAILNET_RANGES) and not own_address(ip)


def fail(msg, code=1):
    print("HATA: " + msg, file=sys.stderr)
