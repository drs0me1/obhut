def rule_opts(spec):
    """iptables -S kuralının seçenekleri: {"-i": "eth0", "--dport": "22", "-j": "ACCEPT", ...}."""
    opts, tokens = {}, spec.split()
    i = 0
    while i < len(tokens):
        tok = tokens[i]
        if tok.startswith("-") and i + 1 < len(tokens) and not tokens[i + 1].startswith("-"):
            if tok != "-m":
                opts[tok] = tokens[i + 1]
            i += 2
        else:
            i += 1
    return opts


def same_net(a, b):
    """İki yazım aynı ağ mı: kayıt "…::0:0/112" yazar, ip6tables "…::/112" gösterir."""
    try:
        return bool(a and b) and ipaddress.ip_network(a, strict=False) == ipaddress.ip_network(b, strict=False)
    except ValueError:
        return False


def classify_rules(chain_kind, rules, env, networks):
    """Projenin zincirlerindeki kuralları sayfanın gruplarına ayırır. Tanınmayan kural "other"
    grubuna düşer (elle eklenmiş ya da kaymış): Konsol onu gizlemez, uyarıyla gösterir."""
    wan = env.get("WAN_INTERFACE", "")
    ts_if = env.get("TAILSCALE_IF", "tailscale0")
    ssh = str(env.get("SSH_PUBLIC_PORT", ""))
    ts_port = str(env.get("TAILSCALE_UDP_PORT", ""))
    by_iface = {n["iface"]: n for n in networks}
    by_port = {str(n["port"]): n for n in networks}
    ui_names = {str(env.get("TORRENT_UI_PORT", "")): "qbittorrent"}
    out = []
    for rule in rules:
        o, spec, pkts = rule_opts(rule["spec"]), rule["spec"], rule["pkts"]
        j, i_if, o_if = o.get("-j", ""), o.get("-i", ""), o.get("-o", "")
        e = {"pkts": pkts, "spec": spec}
        if j == "RETURN" and not i_if and not o_if:
            continue
        if chain_kind == "input":
            if i_if == "lo" and j == "ACCEPT":
                e.update(group="self", kind="lo")
            elif "ESTABLISHED" in o.get("--ctstate", "") and not i_if and j == "ACCEPT":
                e.update(group="self", kind="established")
            elif o.get("-p") == "ipv6-icmp" and j == "ACCEPT":
                e.update(group="self", kind="icmp6")
            elif i_if == ts_if and j == "ACCEPT" and "-p" not in o:
                e.update(group="ts", kind="all")
            elif i_if == wan and j == "DROP" and "-p" not in o:
                e.update(group="wan", kind="drop")
            elif i_if == wan and j == "ACCEPT" and o.get("--dport"):
                port, proto = o["--dport"], o.get("-p", "")
                if port == ssh and proto == "tcp":
                    e.update(group="wan", kind="ssh", port=int(port), proto=proto)
                elif port == ts_port and proto == "udp":
                    e.update(group="wan", kind="tailscale", port=int(port), proto=proto)
                elif port in by_port and proto == "udp":
                    net = by_port[port]
                    e.update(group="wan", kind="wireguard", port=int(port), proto=proto,
                             iface=net["iface"], label=net["label"])
                else:
                    e.update(group="other", kind="unknown")
            elif i_if in by_iface and j == "ACCEPT" and o.get("--dports"):
                ports = [p for p in o["--dports"].split(",") if p]
                e.update(group="wg:" + i_if, kind="ui", proto=o.get("-p", ""), addr=o.get("-d", "").split("/")[0],
                         ports=[{"port": int(p) if p.isdigit() else p, "name": ui_names.get(p, "")} for p in ports])
            elif i_if in by_iface and j == "ACCEPT" and o.get("-p") == "icmp":
                e.update(group="wg:" + i_if, kind="ping", addr=o.get("-d", "").split("/")[0])
            elif i_if in by_iface and j == "DROP":
                e.update(group="wg:" + i_if, kind="drop")
            else:
                e.update(group="other", kind="unknown")
        elif chain_kind == "forward":
            if i_if in by_iface and o_if == wan and j == "ACCEPT":
                e.update(group="wg:" + i_if, kind="egress")
            elif i_if in by_iface and j == "DROP":
                e.update(group="wg:" + i_if, kind="fwd-drop")
            elif o_if in by_iface and j == "ACCEPT" and "ESTABLISHED" in o.get("--ctstate", ""):
                e.update(group="wg:" + o_if, kind="fwd-return")
            elif o_if in by_iface and j == "DROP":
                e.update(group="wg:" + o_if, kind="fwd-in-drop")
            else:
                e.update(group="other", kind="unknown")
        else:  # nat
            src = o.get("-s", "")
            net = next((n for n in networks if same_net(src, n.get("subnet4")) or same_net(src, n.get("subnet6"))), None)
            if net and o_if == wan and j == "MASQUERADE":
                e.update(group="wg:" + net["iface"], kind="nat", subnet=src)
            else:
                e.update(group="other", kind="unknown")
        out.append(e)
    return out


def parse_caddy(text, ts_ip, source):
    """Kurulumun işlediği Caddy dosyalarından siteler: adresler ve her yolun nereye gittiği.
    Genel bir Caddyfile ayrıştırıcısı değildir; şablonlarımızın biçimini okur."""
    sites, cur, depth, ctx, matchers = [], None, 0, [""], {}
    for raw in (text or "").splitlines():
        line = raw.split("#", 1)[0].strip() if raw.lstrip().startswith("#") else raw.strip()
        if not line:
            continue
        if depth == 0 and line.endswith("{") and line.startswith("http://"):
            addrs = [a.strip().replace("http://", "").replace("{$TAILSCALE_IPV4}", ts_ip)
                     for a in line[:-1].split(",") if a.strip()]
            cur = {"addresses": addrs, "routes": [], "source": source}
            sites.append(cur)
            depth, ctx, matchers = 1, [""], {}
            continue
        if line.endswith("{"):
            head = line[:-1].strip()
            if cur is not None and head.startswith("handle"):
                arg = head[len("handle"):].strip()
                ctx.append(matchers.get(arg[1:], arg) if arg.startswith("@") else arg)
            else:
                ctx.append(ctx[-1])
            depth += 1
            continue
        if line == "}":
            depth = max(0, depth - 1)
            if len(ctx) > 1:
                ctx.pop()
            if depth == 0:
                cur = None
            continue
        if cur is None:
            continue
        tokens = line.split()
        if tokens[0].startswith("@") and len(tokens) >= 3 and tokens[1] == "path":
            matchers[tokens[0][1:]] = " ".join(tokens[2:])
        elif tokens[0] == "reverse_proxy" and len(tokens) >= 2:
            cur["routes"].append({"path": ctx[-1], "kind": "proxy", "to": tokens[1]})
        elif tokens[0] == "file_server":
            cur["routes"].append({"path": ctx[-1], "kind": "files", "to": ""})
        elif tokens[0] == "respond":
            cur["routes"].append({"path": ctx[-1], "kind": "respond", "to": " ".join(tokens[1:]).split('"')[1] if '"' in line else ""})
        elif tokens[0] == "redir" and len(tokens) >= 2:
            cur["routes"].append({"path": ctx[-1], "kind": "redirect", "to": tokens[1]})
    return sites


def parse_dnsmasq(text, source):
    """dnsmasq ayarlarından yalnız sayfanın gösterdikleri: dinlenen arayüzler, alan, adlar, DHCP."""
    got = {"listen": [], "domains": [], "names": [], "dhcp": False}
    for raw in (text or "").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        if key == "interface":
            got["listen"].append(value)
        elif key == "local" and value.startswith("/") and value.endswith("/"):
            got["domains"].append(value.strip("/"))
        elif key == "interface-name" and "," in value:
            name, _, iface = value.partition(",")
            got["names"].append({"name": name, "iface": iface, "source": source})
        elif key == "dhcp-range":
            got["dhcp"] = True
    return got


def read_torrent_conf(path):
    """qBittorrent.conf'tan yalnız TORRENT_KEYS; bölüm başlıkları ve öbür anahtarlar atlanır."""
    text = read_text(path)
    if text is None:
        return None
    got = {}
    for raw in text.splitlines():
        key, sep, value = raw.strip().partition("=")
        if sep and key in TORRENT_KEYS:
            got[key] = value
    return got


class Panel:
    def __init__(self, args):
        self.args = args
        self.lock = threading.Lock()
        self.activity = {}
        self.activity_lock = threading.Lock()
        self.sys_lock = threading.Lock()
        self.samples = []
        self.cpu_prev = None
        self.actions_cache = (0.0, [])
        self.settings_cache = (0.0, None)

    # -- master-wg
    def run(self, *argv, binary=False, net=None):
        env = {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C.UTF-8"}
        if self.args.state_env:
            env["STATE_FILE"] = self.args.state
        cmd = [self.args.master_wg] + (["--if", net] if net else []) + list(argv)
        try:
            proc = subprocess.run(cmd, capture_output=True, timeout=120, env=env, stdin=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired) as err:
            return 1, b"" if binary else "", "master-wg çalıştırılamadı (%s)" % err.__class__.__name__
        err_lines = [l for l in proc.stderr.decode("utf-8", "replace").splitlines() if l.strip()]
        message = err_lines[-1] if err_lines else ""
        if message.startswith("HATA: "):
            message = message[6:]
        out = proc.stdout if binary else proc.stdout.decode("utf-8", "replace")
        return proc.returncode, out, message

    # -- modüller (DD-148)
    def env(self):
        env = {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C.UTF-8"}
        if self.args.state_env:
            env["STATE_FILE"] = self.args.state
            # Test: sahte systemd-run/systemctl master-modul ile aynı dizinde durur.
            env["PATH"] = os.path.dirname(os.path.abspath(self.args.master_modul)) + ":" + env["PATH"]
        return env

    def modul(self, *argv, timeout=30):
        try:
            proc = subprocess.run([self.args.master_modul] + list(argv), capture_output=True, timeout=timeout,
                                  env=self.env(), stdin=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired) as err:
            return 1, "", "master-modul çalıştırılamadı (%s)" % err.__class__.__name__
        err_lines = [l for l in proc.stderr.decode("utf-8", "replace").splitlines() if l.strip()]
        message = err_lines[-1][6:] if err_lines and err_lines[-1].startswith("HATA: ") else (err_lines[-1] if err_lines else "")
        return proc.returncode, proc.stdout.decode("utf-8", "replace"), message

    @staticmethod
    def module_unit(mid):
        return "master-modul-%s.service" % mid

    def busy_units(self):
        """Süren modül işlemlerinin birimleri. `is-active` bitmiş (toplanmış) geçici birimi
        yüklemeye çalışır ve her sorguda systemd günlüğüne "Failed to open
        /run/systemd/transient/…" yazdırır; list-units yalnız bellekteki birimlere bakar (v2-120)."""
        try:
            proc = subprocess.run(["systemctl", "list-units", "--plain", "--no-legend", "--no-pager",
                                   "--state=active,activating,deactivating,reloading",
                                   self.module_unit("*")],
                                  timeout=10, env=self.env(), stdin=subprocess.DEVNULL,
                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired):
            return set()
        return {line.split()[0] for line in proc.stdout.decode("utf-8", "replace").splitlines() if line.split()}

    def module_busy(self, mid, busy=None):
        return self.module_unit(mid) in (self.busy_units() if busy is None else busy)

    def modules(self):
        rc, out, message = self.modul("liste")
        if rc != 0:
            raise RuntimeError(message or "modül listesi okunamadı")
        items = []
        busy = self.busy_units()
        for line in out.splitlines():
            f = line.split("\t")
            if len(f) != 8 or not MODULE_ID_RE.match(f[0]):
                continue
            mid, runtime, reg, live, action, step, total, text = f
            progress = None
            if action != "-":
                progress = {"action": action, "step": step, "total": num_or(total, 0), "text": "" if text == "-" else text}
            items.append({"id": mid, "runtime": runtime, "installed": reg in ("calisiyor", "durduruldu"),
                          "state": reg if reg in ("calisiyor", "durduruldu") else "", "live": live,
                          "busy": self.module_busy(mid, busy), "progress": progress})
        return items

    def module_spawn(self, mid, action, with_data):
        """master-modul'ü ayrı bir systemd birimi olarak başlatır: işlem sayfa kapansa da sürer."""
        if self.module_busy(mid):
            return 409, "bu modülde bir işlem sürüyor"
        argv = ["systemd-run", "--unit=" + self.module_unit(mid), "--collect", "--quiet",
                "--description=Konsol modül işlemi: %s %s" % (mid, action)]
        if self.args.state_env:
            argv.append("--setenv=STATE_FILE=%s" % self.args.state)
        argv += [self.args.master_modul, action, mid] + (["--veri"] if action == "kaldir" and with_data else [])
        try:
            proc = subprocess.run(argv, capture_output=True, timeout=20, env=self.env(), stdin=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired) as err:
            return 502, "işlem başlatılamadı (%s)" % err.__class__.__name__
        if proc.returncode != 0:
            lines = [l for l in proc.stderr.decode("utf-8", "replace").splitlines() if l.strip()]
            return 502, "işlem başlatılamadı: %s" % (lines[-1] if lines else "systemd-run %d" % proc.returncode)
        return 202, ""

    def peers(self, net, seen=None):
        rc, out, message = self.run("info", net=net)
        if rc != 0:
            raise RuntimeError(message or "%s peer listesi okunamadı" % net)
        peers = []
        now = time.time()
        for line in out.splitlines():
            f = line.split("\t")
            if len(f) != 11:
                continue
            peer = {
                "name": f[0], "ipv4": f[1], "ipv6": f[2], "handshake": num_or(f[3], 0),
                "rx": num_or(f[4], 0), "tx": num_or(f[5], 0), "profile": f[6] == "var",
                "dns": f[7], "provider": dns_provider(f[7]) if f[7] else "",
                "keepalive": num_or(f[8], 0), "mtu": num_or(f[9], 0), "enabled": f[10] != "0",
            }
            peer["online"], peer["active_at"] = self.observe(net, peer, now, seen)
            peer["online"] = peer["online"] and peer["enabled"]
            peers.append(peer)
        return peers

    def observe(self, net, peer, now, seen):
        """DD-137: cihazdan gelen bayt (rx) son ACTIVE_WINDOW saniyede arttıysa bağlı.

        WireGuard'da "bağlantı" yoktur; el sıkışma yalnız 2 dakikada bir yenilenir, bu
        yüzden kapanan cihaz yalnız ona bakılınca 3 dakika bağlı görünürdü. Yeterince
        izlenmemiş (servis yeni başlamış) bir peer için taze el sıkışmaya bakılır.
        """
        key = (net, peer["name"], peer["ipv4"])
        if seen is not None:
            seen.add(key)
        fresh = peer["handshake"] > 0 and now - peer["handshake"] < HANDSHAKE_FRESH
        with self.activity_lock:
            rec = self.activity.get(key)
            if rec is None or peer["rx"] < rec[0]:
                rec = [peer["rx"], None, now]
                self.activity[key] = rec
            elif peer["rx"] > rec[0]:
                rec[0], rec[1] = peer["rx"], now
            if rec[1] is not None:
                online = now - rec[1] <= ACTIVE_WINDOW
            elif now - rec[2] >= ACTIVE_WINDOW:
                online = False
            else:
                online = fresh
            return online and fresh, (int(rec[1]) if rec[1] is not None else None)

    def sample_forever(self):
        while True:
            try:
                self.state()
            except Exception as err:  # örnekleme durursa sayfa yine el sıkışmaya düşer
                print("panel: sayaç okunamadı (%s)" % err, flush=True)
            try:
                self.sample_system()
            except Exception as err:
                print("panel: sistem ölçülemedi (%s)" % err, flush=True)
            time.sleep(SAMPLE_SECONDS)

    # -- sistem
    def sample_system(self):
        """İşlemci ve bellek kullanımı; grafiğe son SYS_POINTS örnek girer."""
        try:
            with open("/proc/stat", "rb") as fh:
                fields = [int(x) for x in fh.readline().split()[1:]]
        except (OSError, ValueError, IndexError):
            return
        total = sum(fields)
        idle = fields[3] + (fields[4] if len(fields) > 4 else 0)
        previous, self.cpu_prev = self.cpu_prev, (total, idle)
        if previous is None:
            return
        span, span_idle = total - previous[0], idle - previous[1]
        if span <= 0:
            return
        cpu = max(0.0, min(100.0, 100.0 * (span - span_idle) / span))
        mem_total, mem_used = self.meminfo()
        mem = round(100.0 * mem_used / mem_total, 1) if mem_total else 0.0
        with self.sys_lock:
            self.samples.append({"t": int(time.time()), "cpu": round(cpu, 1), "mem": mem})
            del self.samples[:-SYS_POINTS]

    def meminfo(self):
        info = {}
        try:
            with open("/proc/meminfo", "rb") as fh:
                for line in fh:
                    key, _, rest = line.decode("utf-8", "replace").partition(":")
                    parts = rest.split()
                    if parts and parts[0].isdigit():
                        info[key] = int(parts[0]) * 1024
        except OSError:
            return 0, 0
        total = info.get("MemTotal", 0)
        return total, max(0, total - info.get("MemAvailable", 0))

    def os_name(self):
        try:
            with open("/etc/os-release", encoding="utf-8") as fh:
                for line in fh:
                    key, _, value = line.rstrip("\n").partition("=")
                    if key == "PRETTY_NAME":
                        return value.strip('"')
        except OSError:
            pass
        return "Linux"

    def module_state(self, mid, env=None):
        """Modül kaydındaki durum (calisiyor | durduruldu); kurulu değilse ""."""
        env = env if env is not None else read_env(self.args.state)
        path = env.get("MODULES_FILE", "")
        if not path:
            return ""
        try:
            with open(path, encoding="utf-8") as fh:
                for line in fh:
                    f = line.rstrip("\n").split("\t")
                    if len(f) == 2 and f[0] == mid and f[1] in ("calisiyor", "durduruldu"):
                        return f[1]
        except OSError:
            pass
        return ""

    def ports(self, env, networks):
        """Kullanımdaki portlar: state.env ve ağ kaydından; hiçbir yeri taramaz."""
        rows = []
        on = {key: bool(self.module_state(mid, env)) for key, mid in PORT_MODULES.items()}
        for net in networks:
            rows.append({"port": net["port"], "proto": "udp", "scope": "internet",
                         "name": "WireGuard %s%s" % (net["iface"], " · %s" % net["label"] if net["label"] else "")})
        for key, name, proto, scope, default in PORT_ROWS:
            if key in on and not on[key]:
                continue
            port = num_or(env.get(key), default)
            if port:
                rows.append({"port": port, "proto": proto, "scope": scope, "name": name})
        if on["TORRENT_UI_PORT"] and any(net["scope"] == "ui" and net["active"] for net in networks):
            for key, name in WG_UI_ROWS:
                port = num_or(env.get(key), 0)
                if port:
                    rows.append({"port": port, "proto": "tcp", "scope": "wireguard", "name": name})
        return rows

    @staticmethod
    def disk(root):
