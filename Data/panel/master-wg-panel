        """DD-195: is Konsol published on the internet right now (name, WAN IPv4, account)?
        Read at most every few seconds; a removed account or publication closes the door."""
        now = time.monotonic()
        with self.public_lock:
            at, value = self.public_cache
            if now - at >= PUBLIC_CACHE_SECONDS:
                try:
                    value = master_publications.panel_active(read_env(self.args.state))
                except (OSError, ValueError, KeyError, master_settings.SettingsError):
                    value = False
                self.public_cache = (now, value)
            return value

    def auth(self):
        directory = read_env(self.args.state).get("KONSOL_AUTH_DIR")
        if not directory:
            raise master_auth.AuthError("Konsol hesap ayarı eksik; kurulumu yeniden çalıştırın.", 503)
        return master_auth.Store(directory)

    # -- master-wg
    def run(self, *argv, binary=False, net=None):
        env = {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C.UTF-8"}
        if self.args.state_env:
            env["STATE_FILE"] = self.args.state
        cmd = [self.args.master_wg] + (["--if", net] if net else []) + list(argv)
        try:
            proc = subprocess.run(cmd, capture_output=True, timeout=120, env=env, stdin=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired) as err:
            return 1, b"" if binary else "", "master-wg çalıştırılamadı (%s)" % err.__class__.__name__
        err_lines = [l for l in proc.stderr.decode("utf-8", "replace").splitlines() if l.strip()]
        message = err_lines[-1] if err_lines else ""
        if message.startswith("HATA: "):
            message = message[6:]
        out = proc.stdout if binary else proc.stdout.decode("utf-8", "replace")
        return proc.returncode, out, message

    # -- modüller (DD-148)
    def env(self):
        env = {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C.UTF-8"}
        if self.args.state_env:
            env["STATE_FILE"] = self.args.state
            # Test: sahte systemd-run/systemctl master-modul ile aynı dizinde durur.
            env["PATH"] = os.path.dirname(os.path.abspath(self.args.master_modul)) + ":" + env["PATH"]
        return env

    def modul(self, *argv, timeout=30):
        try:
            proc = subprocess.run([self.args.master_modul] + list(argv), capture_output=True, timeout=timeout,
                                  env=self.env(), stdin=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired) as err:
            return 1, "", "master-modul çalıştırılamadı (%s)" % err.__class__.__name__
        err_lines = [l for l in proc.stderr.decode("utf-8", "replace").splitlines() if l.strip()]
        message = err_lines[-1][6:] if err_lines and err_lines[-1].startswith("HATA: ") else (err_lines[-1] if err_lines else "")
        return proc.returncode, proc.stdout.decode("utf-8", "replace"), message

    @staticmethod
    def module_unit(mid):
        return "master-modul-%s.service" % mid

    def busy_units(self):
        """Süren modül işlemlerinin birimleri. `is-active` bitmiş (toplanmış) geçici birimi
        yüklemeye çalışır ve her sorguda systemd günlüğüne "Failed to open
        /run/systemd/transient/…" yazdırır; list-units yalnız bellekteki birimlere bakar (v2-120)."""
        try:
            proc = subprocess.run(["systemctl", "list-units", "--plain", "--no-legend", "--no-pager",
                                   "--state=active,activating,deactivating,reloading",
                                   self.module_unit("*")],
                                  timeout=10, env=self.env(), stdin=subprocess.DEVNULL,
                                  stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired):
            return set()
        return {line.split()[0] for line in proc.stdout.decode("utf-8", "replace").splitlines() if line.split()}

    def module_busy(self, mid, busy=None):
        return self.module_unit(mid) in (self.busy_units() if busy is None else busy)

    def modules(self):
        rc, out, message = self.modul("liste")
        if rc != 0:
            raise RuntimeError(message or "modül listesi okunamadı")
        items = []
        busy = self.busy_units()
        for line in out.splitlines():
            f = line.split("\t")
            if len(f) != 8 or not MODULE_ID_RE.match(f[0]):
                continue
            mid, runtime, reg, live, action, step, total, text = f
            progress = None
            if action != "-":
                progress = {"action": action, "step": step, "total": num_or(total, 0), "text": "" if text == "-" else text}
            item = {"id": mid, "runtime": runtime, "installed": reg in ("calisiyor", "durduruldu"),
                    "state": reg if reg in ("calisiyor", "durduruldu") else "", "live": live,
                    "busy": self.module_busy(mid, busy), "progress": progress}
            if item["installed"]:
                urls = self.package_urls(mid)
                if urls:
                    item["urls"] = urls
            items.append(item)
        return items

    def package_urls(self, mid):
        """DD-195/199: a package with a publication row has a tailnet name and, while its row is
        on and verified, its own public name; Konsol picks by the address the browser used."""
        env = read_env(self.args.state)
        info = master_publications.packages(env).get(mid)
        if not info:
            return None
        urls = {"tailscale": "http://%s.%s" % (info["local"], env["LOCAL_DOMAIN"]) if env.get("LOCAL_DOMAIN") else None,
                "internet": None}
        try:
            rows = master_publications.config(env)
            if master_publications.package_active(env, mid, rows):
                port = int(env["SHARE_HTTPS_PORT"])
                urls["internet"] = "https://%s%s" % (rows[mid]["domain"], "" if port == 443 else ":%d" % port)
        except (master_settings.SettingsError, OSError, ValueError, KeyError):
            pass  # a broken publication record never hides the module list or its tailnet name
        return urls

    def module_spawn(self, mid, action, with_data):
        """master-modul'ü ayrı bir systemd birimi olarak başlatır: işlem sayfa kapansa da sürer."""
        if self.module_busy(mid):
            return 409, "bu modülde bir işlem sürüyor"
        argv = ["systemd-run", "--unit=" + self.module_unit(mid), "--collect", "--quiet",
                "--description=Konsol modül işlemi: %s %s" % (mid, action)]
        if self.args.state_env:
            argv.append("--setenv=STATE_FILE=%s" % self.args.state)
        argv += [self.args.master_modul, action, mid] + (["--veri"] if action == "kaldir" and with_data else [])
        try:
            proc = subprocess.run(argv, capture_output=True, timeout=20, env=self.env(), stdin=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired) as err:
            return 502, "işlem başlatılamadı (%s)" % err.__class__.__name__
        if proc.returncode != 0:
            lines = [l for l in proc.stderr.decode("utf-8", "replace").splitlines() if l.strip()]
            return 502, "işlem başlatılamadı: %s" % (lines[-1] if lines else "systemd-run %d" % proc.returncode)
        return 202, ""

    def peers(self, net, seen=None):
        rc, out, message = self.run("info", net=net)
        if rc != 0:
            raise RuntimeError(message or "%s peer listesi okunamadı" % net)
        peers = []
        now = time.time()
        for line in out.splitlines():
            f = line.split("\t")
            if len(f) != 11:
                continue
            peer = {
                "name": f[0], "ipv4": f[1], "ipv6": f[2], "handshake": num_or(f[3], 0),
                "rx": num_or(f[4], 0), "tx": num_or(f[5], 0), "profile": f[6] == "var",
                "dns": f[7], "provider": dns_provider(f[7]) if f[7] else "",
                "keepalive": num_or(f[8], 0), "mtu": num_or(f[9], 0), "enabled": f[10] != "0",
            }
            peer["online"], peer["active_at"] = self.observe(net, peer, now, seen)
            peer["online"] = peer["online"] and peer["enabled"]
            peers.append(peer)
        return peers

    def observe(self, net, peer, now, seen):
        """DD-137: cihazdan gelen bayt (rx) son ACTIVE_WINDOW saniyede arttıysa bağlı.

        WireGuard'da "bağlantı" yoktur; el sıkışma yalnız 2 dakikada bir yenilenir, bu
        yüzden kapanan cihaz yalnız ona bakılınca 3 dakika bağlı görünürdü. Yeterince
        izlenmemiş (servis yeni başlamış) bir peer için taze el sıkışmaya bakılır.
        """
        key = (net, peer["name"], peer["ipv4"])
        if seen is not None:
            seen.add(key)
        fresh = peer["handshake"] > 0 and now - peer["handshake"] < HANDSHAKE_FRESH
        with self.activity_lock:
            rec = self.activity.get(key)
            if rec is None or peer["rx"] < rec[0]:
                rec = [peer["rx"], None, now]
                self.activity[key] = rec
            elif peer["rx"] > rec[0]:
                rec[0], rec[1] = peer["rx"], now
            if rec[1] is not None:
                online = now - rec[1] <= ACTIVE_WINDOW
            elif now - rec[2] >= ACTIVE_WINDOW:
                online = False
            else:
                online = fresh
            return online and fresh, (int(rec[1]) if rec[1] is not None else None)

    def sample_forever(self):
        while True:
            try:
                self.state()
            except Exception as err:  # örnekleme durursa sayfa yine el sıkışmaya düşer
                print("panel: sayaç okunamadı (%s)" % err, flush=True)
            time.sleep(SAMPLE_SECONDS)

    def sample_resources_forever(self):
        """A slow WireGuard command must not delay host resource sampling."""
        while True:
