ITERATIONS = 600000
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$")
IFACE_RE = re.compile(r"^wg[0-9]$")
USER_RE = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")
AUTH_CACHE_SECONDS = 900
# DD-137: "Bağlı" = son ACTIVE_WINDOW saniyede cihazdan veri geldi (istemci 21 sn'de bir
# canlı tutma paketi yollar). Sayaçlar SAMPLE_SECONDS'ta bir, sayfa açık olmasa da okunur.
ACTIVE_WINDOW = float(os.environ.get("PANEL_ACTIVE_WINDOW", "45"))
SAMPLE_SECONDS = float(os.environ.get("PANEL_SAMPLE_SECONDS", "10"))
HANDSHAKE_FRESH = 180
FAIL_WINDOW_SECONDS = 900
FAIL_LIMIT = 10
MAX_BODY = 4096
# wg0'ı yeniden üretmek için yazılan kelime (panel ve wireguard.command aynı).
CONFIRM_WORD = "onayla"
API_HEADER = "X-Konsol"
REALM = "Konsol"
CSP = ("default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'")
MASK = "•" * 44
# Genel bakıştaki işlemci/bellek grafiği: SAMPLE_SECONDS'ta bir örnek, son 2 dakika.
SYS_POINTS = 12
# Son işlemler: iki arka ucun günlük satırları; journalctl her istekte çalışmaz.
ACTIONS_CACHE_SECONDS = 15
ACTIONS_LIMIT = 40
ACTION_RE = re.compile(r"^(panel|dosya): (\S+) (\S+) (\S+) (.*) -> (ok|hata)$")
# Genel bakıştaki "Kullanımdaki portlar" kartı: yapılandırmadan üretilir, tarama yok.
# (state.env anahtarı, ad, protokol, kapsam, varsayılan)
PORT_ROWS = (
    ("TORRENT_PUBLIC_PORT", "qBittorrent eş trafiği", "tcp+udp", "internet", 0),
    ("TAILSCALE_UDP_PORT", "Tailscale", "udp", "internet", 0),
    ("SSH_PUBLIC_PORT", "SSH", "tcp", "internet", 0),
    ("CADDY_HTTP_PORT", "Caddy — panel ve öbür adresler", "tcp", "tailscale", 80),
    ("DNS_PORT", "dnsmasq — yerel adlar", "udp+tcp", "tailscale", 53),
    ("SHARE_PORT", "Paylaşım WebDAV — yalnız Konsol'dan paylaşılanlar (Infuse)", "tcp", "tailscale", 0),
    ("DOZZLE_UI_PORT", "Dozzle", "tcp", "loopback", 0),
    ("TORRENT_UI_PORT", "qBittorrent arayüzü", "tcp", "loopback", 0),
    ("FILEBROWSER_UI_PORT", "FileBrowser", "tcp", "loopback", 0),
    ("WG_PANEL_PORT", "Konsol · WireGuard arka ucu", "tcp", "loopback", 0),
    ("FILES_PANEL_PORT", "Konsol · dosya arka ucu", "tcp", "loopback", 0),
)
# WireGuard istemcilerine açılan arayüzler (Caddyfile.wg): erişimi "ui" olan ağlarda.
WG_UI_ROWS = (("DOZZLE_UI_PORT", "Dozzle"), ("TORRENT_UI_PORT", "qBittorrent arayüzü"),
              ("FILEBROWSER_UI_PORT", "FileBrowser"))


def fail(msg, code=1):
    print("HATA: " + msg, file=sys.stderr)
    sys.exit(code)


# ----------------------------------------------------------------- hesap
def hash_password(password, salt=None, iterations=ITERATIONS):
    salt = salt if salt is not None else secrets.token_bytes(16)
    digest = hashlib.pbkdf2_hmac("sha256", password, salt, iterations)
    return "pbkdf2_sha256$%d$%s$%s" % (
        iterations, base64.b64encode(salt).decode(), base64.b64encode(digest).decode())


def parse_account(line):
    """'kullanıcı:pbkdf2_sha256$tur$tuz$özet' → (kullanıcı, tur, tuz, özet) ya da None."""
    user, sep, rest = line.strip().partition(":")
    parts = rest.split("$")
    if not sep or not USER_RE.match(user) or len(parts) != 4 or parts[0] != "pbkdf2_sha256":
        return None
    try:
        iterations = int(parts[1])
        salt = base64.b64decode(parts[2], validate=True)
        want = base64.b64decode(parts[3], validate=True)
    except (ValueError, binascii.Error):
        return None
    if iterations < 1 or not salt or len(want) < 16:
        return None
    return user, iterations, salt, want


def account_matches(account, user, password):
    if account is None:
        return False
    got = hashlib.pbkdf2_hmac("sha256", password, account[2], account[1], len(account[3]))
    return hmac.compare_digest(got, account[3]) and hmac.compare_digest(user.encode(), account[0].encode())


def read_account_file(path):
    try:
        with open(path, encoding="utf-8") as fh:
            lines = [l for l in fh.read().splitlines() if l.strip()]
    except OSError:
        return None
    return parse_account(lines[0]) if len(lines) == 1 else None


def cmd_account(args):
    if not USER_RE.match(args.user):
        fail("geçersiz panel kullanıcı adı")
    password = sys.stdin.buffer.read()
    if not password:
        fail("parola boş")
    if account_matches(read_account_file(args.auth), args.user, password):
        print("aynı")
        return
    directory = os.path.dirname(os.path.abspath(args.auth))
    tmp = os.path.join(directory, ".wg-panel-auth-%s" % secrets.token_hex(6))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write("%s:%s\n" % (args.user, hash_password(password)))
        os.chmod(tmp, 0o600)
        os.replace(tmp, args.auth)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    print("yazıldı")


def cmd_check(args):
    password = sys.stdin.buffer.read()
    token = base64.b64encode(args.user.encode() + b":" + password).decode()
    req = urllib.request.Request(args.url, headers={
        "Host": args.host, "Authorization": "Basic " + token, API_HEADER: "1"})
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read().decode())
    except urllib.error.HTTPError as err:
        fail("panel HTTP %d verdi" % err.code)
    except (urllib.error.URLError, ValueError, OSError) as err:
        fail("panel yanıt vermedi (%s)" % err)
    nets = data.get("networks")
    # DD-143: temiz kurulumda hiç ağ yoktur; boş liste de geçerli bir yanıttır.
    if not isinstance(nets, list) or not all(isinstance(n.get("peers"), list) for n in nets):
        fail("panel yanıtı beklenen biçimde değil")
    if not isinstance(data.get("defaults"), dict):
        fail("panel yanıtı beklenen biçimde değil")
    print("%d ağ, %d peer" % (len(nets), sum(len(n["peers"]) for n in nets)))


# --------------------------------------------------------------- sunucu
def read_env(path):
    out = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                key, sep, value = line.rstrip("\n").partition("=")
                if sep and re.match(r"^[A-Z][A-Z0-9_]*$", key):
                    if len(value) >= 2 and value[0] == value[-1] == '"':
                        value = value[1:-1]
                    out[key] = value
    except OSError:
        pass
    return out


def dns_provider(dns):
    tokens = [t.strip() for t in dns.split(",") if t.strip()]
    known = (
        # Aile sürümü Cloudflare'in önekiyle de eşleşir; önce o denenir.
        ("Cloudflare Aile", ("1.1.1.3", "1.0.0.3", "2606:4700:4700::1113", "2606:4700:4700::1003")),
        ("Cloudflare", ("1.1.1.", "1.0.0.", "2606:4700:4700::")),
        ("AdGuard", ("94.140.14.", "94.140.15.", "2a10:50c0::ad")),
        ("Google", ("8.8.8.", "8.8.4.", "2001:4860:4860::")),
        ("Quad9", ("9.9.9.", "149.112.112.", "2620:fe::")),
        ("NextDNS", ("45.90.28.", "45.90.30.", "2a07:a8c0:", "2a07:a8c1:")),
    )
    for name, prefixes in known:
        if tokens and all(t.startswith(prefixes) for t in tokens):
            return name
    return "Özel"


class Panel:
    def __init__(self, args):
        self.args = args
        self.lock = threading.Lock()
        self.fail_lock = threading.Lock()
        self.verified = {}
        self.failures = {}
        self.activity = {}
        self.activity_lock = threading.Lock()
        self.sys_lock = threading.Lock()
        self.samples = []
        self.cpu_prev = None
        self.actions_cache = (0.0, [])
        self.account_mtime = None
        self.account = None

    # -- kimlik
    def current_account(self):
        try:
            mtime = os.stat(self.args.auth).st_mtime_ns
        except OSError:
            self.account, self.account_mtime = None, None
            return None
        if mtime != self.account_mtime:
            self.account = read_account_file(self.args.auth)
            self.account_mtime = mtime
            with self.lock:
                self.verified.clear()
        return self.account

    def locked_out(self, client):
        now = time.time()
        with self.fail_lock:
            recent = [t for t in self.failures.get(client, []) if now - t < FAIL_WINDOW_SECONDS]
            self.failures[client] = recent
            return len(recent) >= FAIL_LIMIT

    def record_failure(self, client):
        with self.fail_lock:
            self.failures.setdefault(client, []).append(time.time())

    def authenticate(self, header):
        """Doğrulanan kullanıcı adı ya da None."""
        account = self.current_account()
        if account is None or not header or not header.startswith("Basic "):
            return None
        key = hashlib.sha256(("%s|%s" % (self.account_mtime, header)).encode()).hexdigest()
        now = time.time()
        with self.lock:
            until = self.verified.get(key)
            if until and until > now:
                return account[0]
        try:
            raw = base64.b64decode(header[6:].strip(), validate=True)
        except (ValueError, binascii.Error):
            return None
        user, sep, password = raw.partition(b":")
        if not sep:
            return None
        try:
            user_text = user.decode("utf-8")
        except UnicodeDecodeError:
            return None
        if not account_matches(account, user_text, password):
            return None
        with self.lock:
            if len(self.verified) > 64:
                self.verified.clear()
            self.verified[key] = now + AUTH_CACHE_SECONDS
        return account[0]

    # -- master-wg
    def run(self, *argv, binary=False, net=None):
        env = {"PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C.UTF-8"}
        if self.args.state_env:
            env["STATE_FILE"] = self.args.state
        cmd = [self.args.master_wg] + (["--if", net] if net else []) + list(argv)
        try:
            proc = subprocess.run(cmd, capture_output=True, timeout=120, env=env, stdin=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired) as err:
            return 1, b"" if binary else "", "master-wg çalıştırılamadı (%s)" % err.__class__.__name__
        err_lines = [l for l in proc.stderr.decode("utf-8", "replace").splitlines() if l.strip()]
        message = err_lines[-1] if err_lines else ""
        if message.startswith("HATA: "):
            message = message[6:]
        out = proc.stdout if binary else proc.stdout.decode("utf-8", "replace")
        return proc.returncode, out, message

    def peers(self, net, seen=None):
        rc, out, message = self.run("info", net=net)
        if rc != 0:
            raise RuntimeError(message or "%s peer listesi okunamadı" % net)
        peers = []
        now = time.time()
        for line in out.splitlines():
            f = line.split("\t")
            if len(f) != 11:
                continue
            peer = {
                "name": f[0], "ipv4": f[1], "ipv6": f[2], "handshake": num_or(f[3], 0),
                "rx": num_or(f[4], 0), "tx": num_or(f[5], 0), "profile": f[6] == "var",
                "dns": f[7], "provider": dns_provider(f[7]) if f[7] else "",
                "keepalive": num_or(f[8], 0), "mtu": num_or(f[9], 0), "enabled": f[10] != "0",
            }
            peer["online"], peer["active_at"] = self.observe(net, peer, now, seen)
            peer["online"] = peer["online"] and peer["enabled"]
            peers.append(peer)
        return peers

    def observe(self, net, peer, now, seen):
        """DD-137: cihazdan gelen bayt (rx) son ACTIVE_WINDOW saniyede arttıysa bağlı.

        WireGuard'da "bağlantı" yoktur; el sıkışma yalnız 2 dakikada bir yenilenir, bu
        yüzden kapanan cihaz yalnız ona bakılınca 3 dakika bağlı görünürdü. Yeterince
        izlenmemiş (servis yeni başlamış) bir peer için taze el sıkışmaya bakılır.
        """
        key = (net, peer["name"], peer["ipv4"])
        if seen is not None:
            seen.add(key)
        fresh = peer["handshake"] > 0 and now - peer["handshake"] < HANDSHAKE_FRESH
        with self.activity_lock:
            rec = self.activity.get(key)
            if rec is None or peer["rx"] < rec[0]:
                rec = [peer["rx"], None, now]
                self.activity[key] = rec
            elif peer["rx"] > rec[0]:
                rec[0], rec[1] = peer["rx"], now
            if rec[1] is not None:
                online = now - rec[1] <= ACTIVE_WINDOW
            elif now - rec[2] >= ACTIVE_WINDOW:
                online = False
            else:
                online = fresh
            return online and fresh, (int(rec[1]) if rec[1] is not None else None)

    def sample_forever(self):
        while True:
            try:
                self.state()
            except Exception as err:  # örnekleme durursa sayfa yine el sıkışmaya düşer
                print("panel: sayaç okunamadı (%s)" % err, flush=True)
            try:
                self.sample_system()
            except Exception as err:
                print("panel: sistem ölçülemedi (%s)" % err, flush=True)
            time.sleep(SAMPLE_SECONDS)

    # -- sistem
    def sample_system(self):
        """İşlemci ve bellek kullanımı; grafiğe son SYS_POINTS örnek girer."""
        try:
            with open("/proc/stat", "rb") as fh:
                fields = [int(x) for x in fh.readline().split()[1:]]
        except (OSError, ValueError, IndexError):
            return
        total = sum(fields)
        idle = fields[3] + (fields[4] if len(fields) > 4 else 0)
        previous, self.cpu_prev = self.cpu_prev, (total, idle)
        if previous is None:
            return
        span, span_idle = total - previous[0], idle - previous[1]
        if span <= 0:
            return
        cpu = max(0.0, min(100.0, 100.0 * (span - span_idle) / span))
        mem_total, mem_used = self.meminfo()
        mem = round(100.0 * mem_used / mem_total, 1) if mem_total else 0.0
        with self.sys_lock:
            self.samples.append({"t": int(time.time()), "cpu": round(cpu, 1), "mem": mem})
            del self.samples[:-SYS_POINTS]

    def meminfo(self):
        info = {}
        try:
            with open("/proc/meminfo", "rb") as fh:
                for line in fh:
                    key, _, rest = line.decode("utf-8", "replace").partition(":")
                    parts = rest.split()
                    if parts and parts[0].isdigit():
                        info[key] = int(parts[0]) * 1024
        except OSError:
            return 0, 0
        total = info.get("MemTotal", 0)
        return total, max(0, total - info.get("MemAvailable", 0))

    def os_name(self):
        try:
            with open("/etc/os-release", encoding="utf-8") as fh:
                for line in fh:
                    key, _, value = line.rstrip("\n").partition("=")
                    if key == "PRETTY_NAME":
                        return value.strip('"')
        except OSError:
            pass
        return "Linux"

    def ports(self, env, networks):
        """Kullanımdaki portlar: state.env ve ağ kaydından; hiçbir yeri taramaz."""
        rows = []
        for net in networks:
            rows.append({"port": net["port"], "proto": "udp", "scope": "internet",
                         "name": "WireGuard %s%s" % (net["iface"], " · %s" % net["label"] if net["label"] else "")})
        for key, name, proto, scope, default in PORT_ROWS:
            port = num_or(env.get(key), default)
            if port:
                rows.append({"port": port, "proto": proto, "scope": scope, "name": name})
        if any(net["scope"] == "ui" and net["active"] for net in networks):
            for key, name in WG_UI_ROWS:
                port = num_or(env.get(key), 0)
                if port:
                    rows.append({"port": port, "proto": "tcp", "scope": "wireguard", "name": name})
        return rows

    def system(self, networks):
        env = read_env(self.args.state)
        with self.sys_lock:
            samples = list(self.samples)
        mem_total, mem_used = self.meminfo()
        try:
            with open("/proc/uptime", "rb") as fh:
                uptime = int(float(fh.read().split()[0]))
        except (OSError, ValueError, IndexError):
            uptime = 0
        return {
            "host": socket.gethostname().split(".")[0],
            "version": env.get("V2_VERSION", ""),
            "domain": env.get("LOCAL_DOMAIN", ""),
            "os": self.os_name(),
            "kernel": platform.release(),
            "uptime": uptime,
            "cores": os.cpu_count() or 1,
            "interval": int(SAMPLE_SECONDS),
            "cpu": [s["cpu"] for s in samples],
            "mem": {"total": mem_total, "used": mem_used, "graph": [s["mem"] for s in samples]},
            "net": {
                "wan": env.get("WAN_IPV4", ""), "wan6": env.get("WAN_IPV6", ""),
                "iface": env.get("WAN_INTERFACE", ""), "tailscale": env.get("TAILSCALE_IPV4", ""),
                "tailscale6": env.get("TAILSCALE_IPV6", ""), "endpoint": env.get("WG_ENDPOINT_HOST", ""),
            },
            "ports": self.ports(env, networks),
            # DD-141: Konsol, Infuse için IP:port adresini bu ikisinden kurar.
            "share": {"port": num_or(env.get("SHARE_PORT"), 0)},
        }

    def actions(self):
        """Son işlemler: iki arka ucun audit satırları (journald), yeniden eskiye."""
        now = time.time()
        stamp, rows = self.actions_cache
        if now - stamp < ACTIONS_CACHE_SECONDS:
            return rows
        cmd = ["journalctl", "-u", "master-wg-panel.service", "-u", "master-files-panel.service",
               "--since", "-7 days", "-n", "400", "-o", "short-unix", "--no-pager"]
        try:
            proc = subprocess.run(cmd, capture_output=True, timeout=15, stdin=subprocess.DEVNULL,
                                  env={"PATH": "/usr/bin:/bin", "LC_ALL": "C.UTF-8"})
            lines = proc.stdout.decode("utf-8", "replace").splitlines() if proc.returncode == 0 else []
        except (OSError, subprocess.SubprocessError):
            lines = []
        rows = []
        for line in lines:
            stamp_text, _, rest = line.partition(" ")
            body = rest.partition(": ")[2]
            m = ACTION_RE.match(body.strip())
            if not m:
                continue
            try:
                when = int(float(stamp_text))
            except ValueError:
                continue
            # Dosya arka ucu ayrıntıyı JSON olarak yazar; sayfada tırnaksız görünsün.
            detail = m.group(5)
            if detail.startswith('"') and detail.endswith('"'):
                try:
                    detail = json.loads(detail)
                except ValueError:
                    pass
            rows.append({"at": when, "source": m.group(1), "user": m.group(2), "client": m.group(3),
                         "action": m.group(4), "detail": detail[:200], "ok": m.group(6) == "ok"})
        rows = rows[-ACTIONS_LIMIT:][::-1]
        self.actions_cache = (now, rows)
        return rows

    def net_rows(self):
        """master-wg nets satırları (peer listesi olmadan); state ve portlar aynı kaynağı okur."""
        rc, out, message = self.run("nets")
        if rc != 0:
            raise RuntimeError(message or "ağ listesi okunamadı")
        rows = []
        for line in out.splitlines():
            f = line.split("\t")
            if len(f) != 11 or not IFACE_RE.match(f[0]):
                continue
            rows.append({
                "iface": f[0], "port": num_or(f[1], 0), "scope": f[2],
                "server4": f[3], "subnet4": f[4], "server6": f[5], "subnet6": f[6],
                "dns": f[7], "label": f[8], "active": f[9] == "1", "count": num_or(f[10], 0),
            })
        return rows

    def state(self):
        """DD-136: bütün ağlar (wg0 + panelde eklenenler), her biri kendi peer'larıyla."""
        env = read_env(self.args.state)
        networks = self.net_rows()
        seen = set()
        for net in networks:
            net["peers"] = self.peers(net["iface"], seen)
        with self.activity_lock:
            for key in [k for k in self.activity if k not in seen]:
                del self.activity[key]
        return {
            "host": socket.gethostname().split(".")[0],
            "version": env.get("V2_VERSION", ""),
            "endpoint": env.get("WG_ENDPOINT_HOST", ""),
            "max": num_or(env.get("WG_NETWORKS_MAX"), 9) + 1,
            "reserved": sorted({num_or(env.get(k), 0) for k in (
                "SSH_PUBLIC_PORT", "TORRENT_PUBLIC_PORT", "DOZZLE_UI_PORT",
                "TORRENT_UI_PORT", "FILEBROWSER_UI_PORT", "TAILSCALE_UDP_PORT", "WG_PANEL_PORT",
                "FILES_PANEL_PORT", "SHARE_PORT")} - {0} | {53, 80}),
            "defaults": {
                "dns": os.environ.get("PANEL_DNS_DEFAULT", "1.1.1.1, 1.0.0.1, 2606:4700:4700::1001"),
                "keepalive": num_or(os.environ.get("PANEL_KEEPALIVE_DEFAULT"), 21),
                "mtu": num_or(os.environ.get("PANEL_MTU_DEFAULT"), 1420),
                # DD-143: ilk ağa önerilen UDP portu; sonrakiler 61020'den sıralanır.
                "port": num_or(env.get("WG_PUBLIC_PORT"), 61001),
            },
            "now": int(time.time()),
            "active_window": int(ACTIVE_WINDOW),
            "networks": networks,
        }


def num_or(value, default):
    return int(value) if value and str(value).isdigit() else default


def mask_profile(text):
    out = []
    for line in text.splitlines():
        key, sep, _ = line.partition(" = ")
        out.append("%s = %s" % (key, MASK) if sep and key in ("PrivateKey", "PresharedKey") else line)
    return "\n".join(out) + "\n"


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "master-wg-panel"
    sys_version = ""
    protocol_version = "HTTP/1.1"
    panel = None

    def log_message(self, fmt, *args):  # isteğin satırı; başlıklar yazılmaz
        sys.stderr.write("panel: %s %s\n" % (self.client(), fmt % args))

    def audit(self, user, action, detail, ok):
        print("panel: %s %s %s %s -> %s" % (user, self.client(), action, detail, "ok" if ok else "hata"), flush=True)

    def client(self):
        peer = self.client_address[0] if self.client_address else "?"
        forwarded = self.headers.get("X-Forwarded-For", "") if self.headers else ""
        if peer in ("127.0.0.1", "::1") and forwarded:
            return forwarded.split(",")[-1].strip()[:64]
        return peer

    # -- yanıt
    def send(self, code, body=b"", ctype="application/json; charset=utf-8", extra=None):
        if isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Security-Policy", CSP)
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Referrer-Policy", "no-referrer")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def json(self, code, obj):
        self.send(code, json.dumps(obj, ensure_ascii=False))

    def error(self, code, message):
        self.json(code, {"error": message})

    # -- kapılar
    def gate(self):
        """Host, kimlik ve (API için) köken denetimi. Kullanıcı adı ya da None (yanıt gönderildi)."""
        host = (self.headers.get("Host") or "").lower()
        if host not in self.allowed_hosts():
            self.error(403, "bu adresten erişilemez")
            return None
        client = self.client()
        if self.panel.locked_out(client):
            self.send(429, json.dumps({"error": "çok fazla hatalı giriş; 15 dakika sonra yeniden deneyin"}),
                      extra={"Retry-After": "900"})
            return None
        user = self.panel.authenticate(self.headers.get("Authorization"))
        if user is None:
            if self.headers.get("Authorization"):
                self.panel.record_failure(client)
                time.sleep(1)
                print("panel: %s giriş başarısız" % client, flush=True)
            self.send(401, json.dumps({"error": "giriş gerekli"}),
                      extra={"WWW-Authenticate": 'Basic realm="%s", charset="UTF-8"' % REALM})
            return None
        if self.path.startswith("/api/"):
            site = self.headers.get("Sec-Fetch-Site")
            if self.headers.get(API_HEADER) != "1" or (site and site not in ("same-origin", "none")):
                self.error(403, "istek reddedildi (yalnız panel sayfasından)")
                return None
        return user

    def allowed_hosts(self):
        env = read_env(self.panel.args.state)
        port = self.server.server_address[1]
        hosts = {"127.0.0.1:%d" % port, "localhost:%d" % port}
        if env.get("LOCAL_DOMAIN"):
            hosts.add("panel.%s" % env["LOCAL_DOMAIN"].lower())
        hosts.update(h.lower() for h in self.panel.args.allow_host)
        return hosts

    def body_json(self):
        if (self.headers.get("Content-Type") or "").split(";")[0].strip() != "application/json":
            return None
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            return None
        if length <= 0 or length > MAX_BODY:
            return None
        try:
            data = json.loads(self.rfile.read(length).decode("utf-8"))
        except (ValueError, UnicodeDecodeError):
            return None
        return data if isinstance(data, dict) else None

    # -- yöntemler
    def do_GET(self):
        user = self.gate()
        if user is None:
            return
        path = urllib.parse.urlsplit(self.path).path
        query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
        if path == "/api/wg/state":
            try:
                self.json(200, self.panel.state())
            except RuntimeError as err:
                self.error(502, str(err))
            return
        if path == "/api/wg/sistem":
            try:
                self.json(200, self.panel.system(self.panel.net_rows()))
            except RuntimeError as err:
                self.error(502, str(err))
            return
        if path == "/api/wg/islemler":
            self.json(200, {"items": self.panel.actions()})
            return
        m = re.match(r"^/api/wg/nets/([^/]+)/peers/([^/]+)/(profile|qr\.png)$", path)
        if m:
            net, name = self.net_and_name(m.group(1), m.group(2))
            if net is None:
                return
            if m.group(3) == "qr.png":
                rc, out, message = self.panel.run("png", name, binary=True, net=net)
                self.audit(user, "qr", "%s/%s" % (net, name), rc == 0)
                if rc != 0 or not out.startswith(b"\x89PNG"):
                    self.error(404, message or "QR üretilemedi")
                    return
                self.send(200, out, "image/png", {"Content-Disposition": 'attachment; filename="%s.png"' % name})
                return
            rc, out, message = self.panel.run("profile", name, net=net)
            if rc != 0:
                self.error(404, message or "profil yok")
                return
            if query.get("masked") == ["1"]:
                self.send(200, mask_profile(out), "text/plain; charset=utf-8")
                return
            self.audit(user, "profil", "%s/%s" % (net, name), True)
            self.send(200, out, "text/plain; charset=utf-8",
                      {"Content-Disposition": 'attachment; filename="%s.conf"' % name})
            return
        self.error(404, "bulunamadı")

    def do_HEAD(self):
        self.do_GET()

    def net_and_name(self, raw_net, raw_name=None):
        net = urllib.parse.unquote(raw_net)
        if not IFACE_RE.match(net):
            self.error(400, "geçersiz arayüz")
            return None, None
        if raw_name is None:
            return net, None
        name = urllib.parse.unquote(raw_name)
        if not NAME_RE.match(name):
            self.error(400, "geçersiz peer adı")
            return None, None
        return net, name

    def confirmed(self, data):
        if str(data.get("confirm", "")).strip().lower() != CONFIRM_WORD:
            self.error(400, "onay için %s yazın" % CONFIRM_WORD)
            return False
        return True

    def do_POST(self):
        user = self.gate()
        if user is None:
            return
        path = urllib.parse.urlsplit(self.path).path
        data = self.body_json()
        if data is None:
            self.error(400, "istek gövdesi JSON olmalı")
            return
        if path == "/api/wg/nets":
            port = str(data.get("port", "")).strip()
            scope = str(data.get("scope", "")).strip()
            dns = str(data.get("dns", "")).strip()
            label = str(data.get("label", "")).strip()
            if not port.isdigit() or scope not in ("inet", "ui") or not dns:
                self.error(400, "port, erişim (inet | ui) ve DNS gerekli")
                return
            rc, out, message = self.panel.run("net-add", port, scope, dns, label)
            parts = out.strip().split("\t")
            self.audit(user, "ag-ekle", parts[0] if rc == 0 else port, rc == 0)
            if rc != 0:
                self.error(400, message or "ağ eklenemedi")
                return
            self.json(201, {"iface": parts[0], "port": num_or(parts[-1], 0)})
            return
        m = re.match(r"^/api/wg/nets/([^/]+)/(remove|reset|peers|durum)$", path)
        if m:
            net, _ = self.net_and_name(m.group(1))
            if net is None:
                return
            if m.group(2) == "remove":
                if not self.confirmed(data):
                    return
                rc, out, message = self.panel.run("net-remove", net, "--onay")
                self.audit(user, "ag-kaldir", net, rc == 0)
                if rc != 0:
                    self.error(400, message or "ağ kaldırılamadı")
                    return
                parts = out.strip().split("\t")
                self.json(200, {"iface": net, "peers": num_or(parts[-1], 0)})
                return
            if m.group(2) == "durum":
                want = "ac" if data.get("on") else "kapat"
                rc, out, message = self.panel.run("net", want, net=net)
                self.audit(user, "ag-durum", "%s %s" % (net, want), rc == 0)
                if rc != 0:
                    self.error(400, message or "ağ durumu değiştirilemedi")
                    return
                self.json(200, {"iface": net, "active": out.strip().split("\t")[-1] == "1"})
                return
            if m.group(2) == "reset":
                if not self.confirmed(data):
                    return
                rc, out, message = self.panel.run("reset", "--onay", net=net)
                self.audit(user, "yeniden-uret", net, rc == 0)
                if rc != 0:
                    self.error(400, message or "%s yeniden üretilemedi" % net)
                    return
                parts = out.strip().split("\t")
                self.json(200, {"peers": num_or(parts[0], 0), "profiles": num_or(parts[-1], 0)})
                return
            name = str(data.get("name", ""))
            if not NAME_RE.match(name):
                self.error(400, "geçersiz peer adı (harf, rakam, . _ -; en çok 32)")
                return
            dns = str(data.get("dns", "")).strip()
            keepalive = str(data.get("keepalive", "")).strip()
            mtu = str(data.get("mtu", "")).strip()
            if not dns or not keepalive.isdigit() or not mtu.isdigit():
                self.error(400, "DNS, keepalive ve MTU gerekli")
                return
            rc, out, message = self.panel.run("add", name, dns, keepalive, mtu, net=net)
            self.audit(user, "ekle", "%s/%s" % (net, name), rc == 0)
            if rc != 0:
                self.error(400, message or "peer eklenemedi")
                return
            self.json(201, {"name": name, "ipv4": out.strip().split("\t")[-1]})
            return
        m = re.match(r"^/api/wg/nets/([^/]+)/peers/([^/]+)/(remove|dns|keepalive|durum)$", path)
        if m:
            net, name = self.net_and_name(m.group(1), m.group(2))
            if net is None:
                return
            if m.group(3) == "remove":
                rc, out, message = self.panel.run("remove", name, net=net)
                self.audit(user, "cikar", "%s/%s" % (net, name), rc == 0)
            elif m.group(3) == "durum":
                want = "ac" if data.get("on") else "kapat"
                rc, out, message = self.panel.run("peer", name, want, net=net)
                self.audit(user, "peer-durum", "%s/%s %s" % (net, name, want), rc == 0)
            elif m.group(3) == "keepalive":
                keepalive = str(data.get("keepalive", "")).strip()
                if not keepalive.isdigit():
                    self.error(400, "keepalive saniye olarak gerekli (0 = kapalı)")
                    return
                rc, out, message = self.panel.run("keepalive", name, keepalive, net=net)
                self.audit(user, "keepalive", "%s/%s %s" % (net, name, keepalive), rc == 0)
            else:
                dns = str(data.get("dns", "")).strip()
                if not dns:
                    self.error(400, "DNS gerekli")
                    return
                rc, out, message = self.panel.run("dns", name, dns, net=net)
                self.audit(user, "dns", "%s/%s" % (net, name), rc == 0)
            if rc != 0:
                self.error(400, message or "işlem yapılamadı")
                return
            self.json(200, {"ok": True})
            return
        self.error(404, "bulunamadı")


class Server(http.server.ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def cmd_serve(args):
    host, _, port = args.listen.rpartition(":")
    if host != "127.0.0.1" or not port.isdigit():
        fail("panel yalnız yerel adresi dinler (127.0.0.1:PORT)")
    Handler.panel = Panel(args)
    httpd = Server((host, int(port)), Handler)
    threading.Thread(target=Handler.panel.sample_forever, name="sampler", daemon=True).start()
    print("panel: %s:%s dinleniyor" % (host, port), flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass


def main():
    parser = argparse.ArgumentParser(prog="master-wg-panel")
    sub = parser.add_subparsers(dest="cmd")
    s = sub.add_parser("serve")
    s.add_argument("--listen", required=True)
    s.add_argument("--state", required=True)
    s.add_argument("--auth", required=True)
    s.add_argument("--master-wg", dest="master_wg", required=True)
    s.add_argument("--allow-host", dest="allow_host", action="append", default=[])
    s.add_argument("--state-env", dest="state_env", action="store_true",
                   help="master-wg'ye STATE_FILE olarak --state verilir (test)")
    a = sub.add_parser("account")
    a.add_argument("--auth", required=True)
    a.add_argument("--user", required=True)
    c = sub.add_parser("check")
    c.add_argument("--url", required=True)
    c.add_argument("--host", required=True)
    c.add_argument("--user", required=True)
    args = parser.parse_args()
    if args.cmd == "serve":
        cmd_serve(args)
    elif args.cmd == "account":
        cmd_account(args)
    elif args.cmd == "check":
        cmd_check(args)
    else:
        parser.print_usage()
        sys.exit(2)


if __name__ == "__main__":
    main()
