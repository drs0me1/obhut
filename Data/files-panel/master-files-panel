TRASH_RE = re.compile(r"^\.[a-z]{1,16}$")
# DD-141: paylaşım klasörü. <kök>/.pay sunulmaz; yalnız içindeki w/ paylaşım WebDAV'ının
# köküdür ve kayıt (kayit.json) onun dışında durur. Paylaşılan öge w/ içine göreli bir
# sembolik bağlantı olarak konur: kopya yok, klasöre sonradan inen dosya kendiliğinden görünür.
SHARE_SERVED = "w"
SHARE_REGISTRY = "kayit.json"
# DD-149: Paylaşım modülü kuruluyken .pay içinde durur (master-modul koyar ve kaldırır).
# Modül kaydı bu servise kapalıdır (/etc/master-stack 0700); yeni paylaşım yalnız işaret varken açılır.
SHARE_ENABLED = "acik"
MAX_SHARES = 100
MAX_SHARE_DAYS = 3650
TOKEN_RE = re.compile(r"^[0-9]{13}-[0-9a-f]{8}$")
CONTROL_RE = re.compile(r"[\x00-\x1f\x7f]")
MAX_BODY = 262144
# Yükleme (DD-145): gövde diske akıtılır, belleğe alınmaz. Sınır disk boşluğuyla değil
# kabalıkla ilgili: bir istek en çok bu kadar sürebilir/olabilir.
UPLOAD_MAX_BYTES = 64 * 1024 * 1024 * 1024
UPLOAD_CHUNK = 1024 * 1024
# Gövde okunmadan hata dönülürse bağlantı sıfırlanır ve Caddy bunu 502'ye çevirir; o yüzden
# en çok bu kadarı okunup atılır, sonra anlamlı hata gider. Daha büyüğünde bağlantı kapanır.
UPLOAD_DRAIN_MAX = 256 * 1024 * 1024
MAX_NAMES = 1000
MAX_DEPTH = 64
TEXT_LIMIT = 1024 * 1024
SNIFF_BYTES = 8192
# Bir listelemede klasör boyutları için en çok bu kadar girdiye bakılır; aşılırsa boyut "—".
WALK_BUDGET = 200000
CONFIRM_WORD = "onayla"
API_HEADER = "X-Konsol"
# Günlükte işlemi yapan: hesap yok, istek Konsol'dan gelir (adres ayrıca yazılır).
ACTOR = "konsol"
# Disk kartındaki "indirilenler" toplamı: kök ağacının yürüyüşü pahalıdır, önbelleğe alınır.
USAGE_CACHE_SECONDS = 300
ENCODINGS = {"utf-8": "utf-8-sig", "cp1254": "cp1254", "cp437": "cp437"}
CSP = ("default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob:; "
       "connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'")
O_DIR = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
O_FILE = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | getattr(os, "O_CLOEXEC", 0)
RENAME_NOREPLACE = 1


def fail(msg, code=1):
    print("HATA: " + msg, file=sys.stderr)
    sys.exit(code)


class PanelError(Exception):
    def __init__(self, code, message):
        Exception.__init__(self, message)
        self.code = code
        self.message = message


def cmd_check(args):
    req = urllib.request.Request(args.url, headers={"Host": args.host, API_HEADER: "1"})
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read().decode())
    except urllib.error.HTTPError as err:
        fail("panel HTTP %d verdi" % err.code)
    except (urllib.error.URLError, ValueError, OSError) as err:
        fail("panel yanıt vermedi (%s)" % err)
    if not isinstance(data, dict):
        fail("panel yanıtı beklenen biçimde değil")
    trash = data.get("trash")
    if not isinstance(data.get("root"), str) or not isinstance(trash, dict) or not data.get("writable"):
        fail("panel yanıtı beklenen biçimde değil ya da kök yazılamıyor")
    print("kök %s, çöpte %d öge" % (data["root"], trash.get("count", 0)))


# ------------------------------------------------------------ dosya sistemi
class DirFd:
    def __init__(self, fd):
        self.fd = fd

    def __enter__(self):
        return self.fd

    def __exit__(self, *exc):
        os.close(self.fd)


_renameat2 = None


def rename_noreplace(src_fd, src, dst_fd, dst):
    """src'yi dst'ye taşır; dst varsa FileExistsError. Dizin tanıtıcılarına göre, bağlantı izlemez."""
    global _renameat2
    if _renameat2 is None:
        try:
            fn = ctypes.CDLL(None, use_errno=True).renameat2
            fn.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
            fn.restype = ctypes.c_int
            _renameat2 = fn
        except (OSError, AttributeError):
            _renameat2 = False
    if _renameat2:
        if _renameat2(src_fd, os.fsencode(src), dst_fd, os.fsencode(dst), RENAME_NOREPLACE) == 0:
            return
        code = ctypes.get_errno()
        if code not in (errno.EINVAL, errno.ENOSYS):
            raise OSError(code, os.strerror(code))
    # Yedek yol: dosya sistemi RENAME_NOREPLACE bilmiyorsa (ya da testlerdeki macOS'ta)
    # önce hedefe bakılır. Aynı anda tek işlem yapıldığı için (panel kilidi) yeterli.
    try:
        os.stat(dst, dir_fd=dst_fd, follow_symlinks=False)
    except FileNotFoundError:
        os.rename(src, dst, src_dir_fd=src_fd, dst_dir_fd=dst_fd)
        return
    raise OSError(errno.EEXIST, os.strerror(errno.EEXIST))


def valid_name(name):
    if not isinstance(name, str) or name in ("", ".", "..") or "/" in name or "\x00" in name:
        return False
    try:
        return len(name.encode("utf-8")) <= 255
    except UnicodeEncodeError:
        return False


def numbered(name, i):
    dot = name.rfind(".")
    if dot > 0:
        return "%s (%d)%s" % (name[:dot], i, name[dot:])
    return "%s (%d)" % (name, i)


def dir_size(parent_fd, name, budget):
    fd = os.open(name, O_DIR, dir_fd=parent_fd)
    total = 0
    try:
        with os.scandir(fd) as it:
            for entry in it:
                budget[0] -= 1
                if budget[0] < 0:
                    raise OverflowError("bütçe")
                try:
                    st = entry.stat(follow_symlinks=False)
                except OSError:
                    continue
                if stat.S_ISDIR(st.st_mode):
                    try:
                        total += dir_size(fd, entry.name, budget)
                    except (OSError, RecursionError):
                        continue
                elif stat.S_ISREG(st.st_mode):
                    total += st.st_size
    finally:
        os.close(fd)
    return total


def rmtree_at(parent_fd, name):
    try:
        st = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    except FileNotFoundError:
        return
    if not stat.S_ISDIR(st.st_mode):
        os.unlink(name, dir_fd=parent_fd)
        return
    fd = os.open(name, O_DIR, dir_fd=parent_fd)
    try:
        with os.scandir(fd) as it:
            names = [e.name for e in it]
        for child in names:
            rmtree_at(fd, child)
    finally:
        os.close(fd)
    os.rmdir(name, dir_fd=parent_fd)


def read_json_at(dir_fd, name):
    try:
        fd = os.open(name, O_FILE, dir_fd=dir_fd)
    except OSError:
        return None
    with os.fdopen(fd, "rb") as fh:
        if not stat.S_ISREG(os.fstat(fh.fileno()).st_mode):
            return None
        raw = fh.read(65537)
    try:
        data = json.loads(raw.decode("utf-8")) if len(raw) <= 65536 else None
    except (ValueError, UnicodeDecodeError):
        return None
    return data if isinstance(data, dict) else None


def write_json_at(dir_fd, name, obj):
    tmp = ".%s.%s.tmp" % (name, secrets.token_hex(4))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0),
                 0o600, dir_fd=dir_fd)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(obj, fh, ensure_ascii=False)
        os.rename(tmp, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=dir_fd)
        except OSError:
            pass
        raise


def guess_encoding(data, name, truncated):
    try:
        data.decode("utf-8")
        valid = True
    except UnicodeDecodeError as err:
        # Kesilen dosyanın sonunda yarım kalmış çok baytlı karakter UTF-8'i bozmaz.
        valid = truncated and err.start >= len(data) - 3 and "end of data" in err.reason
    nfo = name.lower().endswith(".nfo")
    if valid and not (nfo and data.isascii()):
        return "utf-8"
    return "cp437" if nfo else "cp1254"


class Files:
    """Kök altındaki bütün işlemler. Yollar parça listesidir; kök []."""

    def __init__(self, root, trash, share=""):
        self.root = root
        self.trash = trash
        self.share = share
        self.lock = threading.Lock()

    # -- yollar
    def split(self, raw):
        if not isinstance(raw, str):
            raise PanelError(400, "geçersiz yol")
        raw = raw.strip("/")
        if not raw:
            return []
        parts = raw.split("/")
        if len(parts) > MAX_DEPTH or not all(valid_name(p) for p in parts):
            raise PanelError(400, "geçersiz yol")
        if parts[0] == self.trash:
            raise PanelError(403, "çöpe yalnız Çöp sekmesinden erişilir")
        if self.share and parts[0] == self.share:
            raise PanelError(403, "paylaşım klasörüne yalnız Paylaşımlar sekmesinden erişilir")
        return parts

    def check_new_name(self, parts, name):
        if not valid_name(name) or CONTROL_RE.search(name) or name != name.strip():
            raise PanelError(400, "geçersiz ad (boş olamaz, / içeremez, en çok 255 bayt)")
        if not parts and name in (self.trash, self.share):
            raise PanelError(400, "bu ad çöp ve paylaşım klasörü için ayrılmış")

    def open_dir(self, parts):
        fd = os.open(self.root, O_DIR)
        try:
            for part in parts:
                nxt = os.open(part, O_DIR, dir_fd=fd)
                os.close(fd)
                fd = nxt
        except BaseException:
            os.close(fd)
            raise
        return fd

    def trash_dir(self, create):
        with DirFd(self.open_dir([])) as root:
            if create:
                try:
                    os.mkdir(self.trash, 0o775, dir_fd=root)
                except FileExistsError:
                    pass
            return os.open(self.trash, O_DIR, dir_fd=root)

    # -- okuma
    def info(self, dir_fd, name, budget, sizes=True):
        st = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
        item = {"name": name, "mtime": int(st.st_mtime), "size": None}
        if stat.S_ISDIR(st.st_mode):
            item["type"] = "dir"
            try:
                with DirFd(os.open(name, O_DIR, dir_fd=dir_fd)) as fd:
                    with os.scandir(fd) as it:
                        item["count"] = sum(1 for _ in it)
            except OSError:
                item["count"] = None
            if sizes:
                try:
                    item["size"] = dir_size(dir_fd, name, budget)
                except (OSError, OverflowError, RecursionError):
                    item["size"] = None
        elif stat.S_ISREG(st.st_mode):
            item["type"] = "file"
            item["size"] = st.st_size
        else:
            item["type"] = "link" if stat.S_ISLNK(st.st_mode) else "other"
        return item

    def listing(self, parts, dirs_only):
        entries, skipped, budget = [], 0, [WALK_BUDGET]
        with DirFd(self.open_dir(parts)) as fd:
            with os.scandir(fd) as it:
                names = [e.name for e in it]
            for name in names:
                if not parts and name in (self.trash, self.share):
                    continue
                if not valid_name(name):
                    skipped += 1
                    continue
                try:
                    item = self.info(fd, name, budget, sizes=not dirs_only)
                except OSError:
                    continue
                if not dirs_only or item["type"] == "dir":
                    entries.append(item)
        return {"path": "/".join(parts), "entries": entries, "skipped": skipped}

    # -- paylaşım (DD-141)
    def share_dir(self, create):
        """<kök>/.pay tanıtıcısı; create ise .pay ve .pay/w oluşturulur."""
        with DirFd(self.open_dir([])) as root:
            if create:
                try:
                    os.mkdir(self.share, 0o755, dir_fd=root)
                except FileExistsError:
                    pass
            fd = os.open(self.share, O_DIR, dir_fd=root)
        if create:
            try:
                os.mkdir(SHARE_SERVED, 0o755, dir_fd=fd)
            except FileExistsError:
                pass
            except BaseException:
                os.close(fd)
                raise
        return fd

    def share_enabled(self):
        """Paylaşım modülü kurulu mu: .pay/acik düz bir dosya olarak duruyor mu (bağlantı izlenmez)."""
        if not self.share:
            return False
        try:
            with DirFd(self.open_dir([])) as root:
                with DirFd(os.open(self.share, O_DIR, dir_fd=root)) as fd:
                    st = os.stat(SHARE_ENABLED, dir_fd=fd, follow_symlinks=False)
        except OSError:
            return False
        return stat.S_ISREG(st.st_mode)

    def shares(self):
        """Paylaşım listesi; süresi dolanları ve kayıtta olmayan bağlantıları temizler."""
        if not self.share:
            return []
        try:
            pay = self.share_dir(create=False)
        except FileNotFoundError:
            return []
        now = int(time.time())
        keep, changed = [], False
        with DirFd(pay) as fd:
            data = read_json_at(fd, SHARE_REGISTRY) or {}
            items = data.get("items")
            items = items if isinstance(items, list) else []
            try:
                wfd = os.open(SHARE_SERVED, O_DIR, dir_fd=fd)
            except FileNotFoundError:
                return []
            with DirFd(wfd):
                names = set(os.listdir(wfd))
                for item in items:
                    name, path = item.get("name"), item.get("path")
                    if not isinstance(name, str) or not isinstance(path, str) or name not in names:
                        changed = True
                        continue
                    expires = item.get("expires")
                    if isinstance(expires, int) and expires <= now:
                        try:
                            os.unlink(name, dir_fd=wfd)
                        except OSError:
                            pass
                        changed = True
                        continue
                    keep.append(item)
                for extra in names - {i["name"] for i in keep}:
                    try:
                        os.unlink(extra, dir_fd=wfd)
                    except OSError:
                        pass
                    changed = True
            if changed:
                write_json_at(fd, SHARE_REGISTRY, {"items": keep})
        return keep

    def free_share_name(self, base, used):
        name = base if valid_name(base) else "paylasim"
        if name not in used:
            return name
        stem, dot, ext = name.partition(".")
        for i in range(2, 200):
            candidate = "%s-%d%s%s" % (stem, i, dot, ext)
            if candidate not in used and valid_name(candidate):
                return candidate
        raise PanelError(400, "paylaşım için boş ad bulunamadı")

    def share_add(self, parts, days):
        if not self.share_enabled():
            raise PanelError(409, "Paylaşım modülü kurulu değil")
        if not parts:
            raise PanelError(400, "kökün tamamı paylaşılamaz")
        with DirFd(self.open_dir(parts[:-1])) as pfd:
            st = os.stat(parts[-1], dir_fd=pfd, follow_symlinks=False)
        if not (stat.S_ISDIR(st.st_mode) or stat.S_ISREG(st.st_mode)):
            raise PanelError(400, "yalnız klasör ya da dosya paylaşılabilir")
        items = self.shares()
        if len(items) >= MAX_SHARES:
            raise PanelError(400, "en çok %d paylaşım olabilir" % MAX_SHARES)
        path = "/".join(parts)
        if any(item.get("path") == path for item in items):
            raise PanelError(409, "bu öge zaten paylaşımda")
        name = self.free_share_name(parts[-1], {i["name"] for i in items})
        now = int(time.time())
        item = {"name": name, "path": path, "type": "dir" if stat.S_ISDIR(st.st_mode) else "file",
                "created": now, "expires": (now + days * 86400) if days else None}
        with DirFd(self.share_dir(create=True)) as fd:
            with DirFd(os.open(SHARE_SERVED, O_DIR, dir_fd=fd)) as wfd:
                # .pay/w/<ad> → ../../<yol>: hedef kökün içinde kalır, kopya yapılmaz.
                os.symlink("/".join([".."] * 2 + parts), name, dir_fd=wfd)
            try:
                write_json_at(fd, SHARE_REGISTRY, {"items": items + [item]})
            except BaseException:
                with DirFd(os.open(SHARE_SERVED, O_DIR, dir_fd=fd)) as wfd:
                    try:
                        os.unlink(name, dir_fd=wfd)
                    except OSError:
                        pass
                raise
        return item

    def share_remove(self, name):
        items = self.shares()
        keep = [i for i in items if i.get("name") != name]
        if len(keep) == len(items):
            raise PanelError(404, "böyle bir paylaşım yok")
        with DirFd(self.share_dir(create=False)) as fd:
            with DirFd(os.open(SHARE_SERVED, O_DIR, dir_fd=fd)) as wfd:
                try:
                    os.unlink(name, dir_fd=wfd)
                except FileNotFoundError:
                    pass
            write_json_at(fd, SHARE_REGISTRY, {"items": keep})
        return keep

    def used(self):
        """Kökün toplam boyutu (çöp hariç); bütçe aşılırsa None."""
        total, budget = 0, [WALK_BUDGET]
        with DirFd(self.open_dir([])) as fd:
            with os.scandir(fd) as it:
                names = [e.name for e in it]
            for name in names:
                if name in (self.trash, self.share) or not valid_name(name):
                    continue
                try:
                    st = os.stat(name, dir_fd=fd, follow_symlinks=False)
                    if stat.S_ISDIR(st.st_mode):
                        total += dir_size(fd, name, budget)
                    elif stat.S_ISREG(st.st_mode):
                        total += st.st_size
                except OverflowError:
                    return None
                except (OSError, RecursionError):
                    continue
        return total

    def trash_items(self):
        try:
            cop = self.trash_dir(create=False)
        except FileNotFoundError:
            return []
        items, budget = [], [WALK_BUDGET]
        with DirFd(cop):
            with os.scandir(cop) as it:
                tokens = [e.name for e in it if TOKEN_RE.match(e.name) and e.is_dir(follow_symlinks=False)]
            for token in tokens:
                meta = read_json_at(cop, token + ".json") or {}
                try:
                    with DirFd(os.open(token, O_DIR, dir_fd=cop)) as tfd:
                        with os.scandir(tfd) as it:
                            names = [e.name for e in it]
                        if len(names) == 1 and valid_name(names[0]):
                            item = self.info(tfd, names[0], budget)
                        else:
                            item = {"name": "(bozuk kayıt)", "type": "other", "size": None, "broken": True,
                                    "mtime": int(token[:13]) // 1000}
                except OSError:
                    continue
                origin = meta.get("from")
                try:
                    origin = "/".join(self.split(origin)) if isinstance(origin, str) else None
                except PanelError:
                    origin = None
                deleted = meta.get("deleted")
                item.update({"id": token, "from": origin,
                             "deleted": deleted if isinstance(deleted, int) else int(token[:13]) // 1000})
                items.append(item)
        items.sort(key=lambda i: i["id"], reverse=True)
        return items

    def open_file(self, parts):
        if not parts:
            raise PanelError(400, "dosya değil")
        with DirFd(self.open_dir(parts[:-1])) as dfd:
            fd = os.open(parts[-1], O_FILE, dir_fd=dfd)
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            os.close(fd)
            raise PanelError(400, "dosya değil")
        return fd, st

    def text(self, parts, enc):
        if enc not in ("auto", "") and enc not in ENCODINGS:
            raise PanelError(400, "geçersiz kodlama")
        fd, st = self.open_file(parts)
        with os.fdopen(fd, "rb") as fh:
            data = fh.read(TEXT_LIMIT)
        truncated = st.st_size > len(data)
        if b"\x00" in data[:SNIFF_BYTES]:
            raise PanelError(415, "metin dosyası değil")
        detected = guess_encoding(data, parts[-1], truncated)
        chosen = detected if enc in ("auto", "") else enc
        return {"path": "/".join(parts), "size": st.st_size, "mtime": int(st.st_mtime),
                "truncated": truncated, "detected": detected, "encoding": chosen,
                "text": data.decode(ENCODINGS[chosen], errors="replace")}

    # -- değişiklik (çağıran self.lock'u tutar)
    def mkdir(self, parts, name):
        self.check_new_name(parts, name)
        with DirFd(self.open_dir(parts)) as fd:
            os.mkdir(name, 0o775, dir_fd=fd)

    def rename(self, parts, name, new):
        if not valid_name(name):
            raise PanelError(400, "geçersiz ad")
        self.check_new_name(parts, new)
        if name == new:
            return
        with DirFd(self.open_dir(parts)) as fd:
            rename_noreplace(fd, name, fd, new)

    def move(self, parts, names, dest):
        if dest == parts:
            raise PanelError(400, "seçilenler zaten bu klasörde")
        for name in names:
            if dest[:len(parts) + 1] == parts + [name]:
                raise PanelError(400, "bir klasör kendi içine taşınamaz")
        moved = []
        with DirFd(self.open_dir(parts)) as sfd, DirFd(self.open_dir(dest)) as dfd:
            for name in names:
                try:
                    os.stat(name, dir_fd=dfd, follow_symlinks=False)
                except FileNotFoundError:
                    continue
                raise PanelError(409, "“%s” hedefte zaten var; üzerine yazılmaz" % name)
            for name in names:
                try:
                    rename_noreplace(sfd, name, dfd, name)
                except OSError as err:
                    if not moved:
                        raise
                    raise PanelError(status_for(err), "%d öge taşındı; “%s” taşınamadı: %s"
                                     % (len(moved), name, os_message(err)))
                moved.append(name)
        return moved

    def upload_check(self, parts, name):
        """Gövde okunmadan önceki denetimler: geçerli ad, var olan klasör, boş hedef."""
        self.check_new_name(parts, name)
        with DirFd(self.open_dir(parts)) as fd:
            try:
                os.stat(name, dir_fd=fd, follow_symlinks=False)
            except FileNotFoundError:
                return
        raise PanelError(409, "“%s” zaten var; üzerine yazılmaz" % name)

    def upload(self, parts, name, stream, length):
        """Akışı <parts>/<name> olarak yazar. Geçici ada yazılır, bitince atomik taşınır:
        yarım kalan dosya listeye hiç girmez, var olanın üzerine yazılmaz (DD-145)."""
        self.upload_check(parts, name)
        tmp = ".yukleniyor-%s" % secrets.token_hex(6)
        written = 0
        with DirFd(self.open_dir(parts)) as fd:
            handle = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o664, dir_fd=fd)
            try:
                # umask ne olursa olsun ağacın kuralı: dosya 0664 (qBittorrent ve
                # unpackerr aynı grupla yazar; ensure_downloads_tree de bunu bekler).
                os.fchmod(handle, 0o664)
                while written < length:
                    chunk = stream.read(min(UPLOAD_CHUNK, length - written))
                    if not chunk:
                        raise PanelError(400, "yükleme yarıda kesildi")
                    os.write(handle, chunk)
                    written += len(chunk)
                os.fsync(handle)
            except BaseException:
                os.close(handle)
                try:
                    os.unlink(tmp, dir_fd=fd)
                except OSError:
                    pass
                raise
            os.close(handle)
            try:
                # Akış kilitsiz sürer (saatlerce sürebilir); yalnız son adım kilitli:
                # ad çakışmasına bakan yedek rename yolu için yeterli.
                with self.lock:
                    rename_noreplace(fd, tmp, fd, name)
            except BaseException:
                try:
                    os.unlink(tmp, dir_fd=fd)
                except OSError:
                    pass
                raise
        return written

    def to_trash(self, parts, names):
        ids = []
        with DirFd(self.open_dir(parts)) as sfd, DirFd(self.trash_dir(create=True)) as cop:
            for name in names:
                token = "%013d-%s" % (int(time.time() * 1000), secrets.token_hex(4))
                os.mkdir(token, 0o775, dir_fd=cop)
                try:
                    write_json_at(cop, token + ".json", {"from": "/".join(parts), "name": name,
                                                         "deleted": int(time.time())})
                    with DirFd(os.open(token, O_DIR, dir_fd=cop)) as tfd:
                        rename_noreplace(sfd, name, tfd, name)
                except BaseException as err:
                    for undo in (lambda: os.unlink(token + ".json", dir_fd=cop), lambda: os.rmdir(token, dir_fd=cop)):
                        try:
                            undo()
                        except OSError:
                            pass
                    if ids and isinstance(err, OSError):
                        raise PanelError(status_for(err), "%d öge çöpe taşındı; “%s” taşınamadı: %s"
                                         % (len(ids), name, os_message(err)))
                    raise
                ids.append(token)
        return ids

    def restore(self, ids):
        done = []
        with DirFd(self.trash_dir(create=False)) as cop:
            for token in ids:
                meta = read_json_at(cop, token + ".json") or {}
                with DirFd(os.open(token, O_DIR, dir_fd=cop)) as tfd:
                    with os.scandir(tfd) as it:
                        names = [e.name for e in it]
                    if len(names) != 1 or not valid_name(names[0]):
                        raise PanelError(400, "çöp kaydı bozuk; kalıcı silin")
                    dest = []
                    try:
                        if isinstance(meta.get("from"), str):
                            dest = self.split(meta["from"])
                        dfd = self.open_dir(dest)
                    except (PanelError, OSError):
                        dest = []
                        dfd = self.open_dir([])
                    with DirFd(dfd):
                        final = self.place(tfd, names[0], dfd, dest)
                os.rmdir(token, dir_fd=cop)
                try:
                    os.unlink(token + ".json", dir_fd=cop)
                except FileNotFoundError:
                    pass
                done.append({"id": token, "path": "/".join(dest), "name": final})
        return done

    def place(self, src_fd, name, dst_fd, dest):
        candidate = name
        for i in range(2, 102):
            if dest or candidate != self.trash:
                try:
                    rename_noreplace(src_fd, name, dst_fd, candidate)
                    return candidate
                except FileExistsError:
                    pass
            candidate = numbered(name, i)
        raise PanelError(409, "geri yüklemek için boş bir ad bulunamadı")

    def purge(self, ids):
        with DirFd(self.trash_dir(create=False)) as cop:
            for token in ids:
                rmtree_at(cop, token)
                try:
                    os.unlink(token + ".json", dir_fd=cop)
                except FileNotFoundError:
                    pass

    def empty(self):
        try:
            cop = self.trash_dir(create=False)
        except FileNotFoundError:
            return 0
        with DirFd(cop):
            with os.scandir(cop) as it:
                names = [e.name for e in it]
            for name in names:
                rmtree_at(cop, name)
        return sum(1 for n in names if TOKEN_RE.match(n))


def os_message(err):
    return {
        errno.ENOENT: "bulunamadı (taşınmış ya da silinmiş olabilir)",
        errno.EEXIST: "aynı adla bir öge var; üzerine yazılmaz",
        errno.ENOTEMPTY: "aynı adla bir öge var; üzerine yazılmaz",
        errno.ENOTDIR: "klasör değil",
        errno.ELOOP: "sembolik bağlantı izlenmez",
        errno.EACCES: "izin yok",
        errno.EPERM: "izin yok",
        errno.EXDEV: "farklı bir diske taşınamaz",
        errno.EINVAL: "bir klasör kendi içine taşınamaz",
        errno.ENOSPC: "diskte yer yok",
        errno.EROFS: "dosya sistemi salt okunur",
        errno.ENAMETOOLONG: "ad çok uzun",
        errno.EBUSY: "öge kullanımda",
    }.get(err.errno, "işlem yapılamadı (%s)" % errno.errorcode.get(err.errno, err.errno))


def status_for(err):
    if err.errno == errno.ENOENT:
        return 404
    if err.errno in (errno.EEXIST, errno.ENOTEMPTY):
        return 409
    if err.errno in (errno.EACCES, errno.EPERM):
        return 403
    return 400


