{
	# DD-180: yönetim arayüzü TCP'de değil; klasörü yalnız Caddy'ye açık bir sokette.
	admin unix/__CADDY_ADMIN_SOCKET__
	default_bind {$TAILSCALE_IPV4}
	http_port __CADDY_HTTP_PORT__
	auto_https disable_redirects
	# DD-193: a media player closing a probe or stream mid-response is normal and
	# was logged as a proxy WARN each time. Proxy messages keep ERROR and above;
	# dial/5xx failures are logged by http.log.error in the default logger.
	log default {
		exclude http.handlers.reverse_proxy
	}
	log proxy {
		include http.handlers.reverse_proxy
		level ERROR
	}
	# DD-179: only the optional public DAV socket; tailnet streams are unchanged.
	servers __WAN_IPV4__:__SHARE_PORT__ {
		timeouts {
			read_header 10s
			idle 30s
		}
	}
	servers __WAN_IPV4__:__SHARE_HTTPS_PORT__ {
		protocols h1 h2
		strict_sni_host on
		timeouts {
			read_header 10s
			idle 30s
		}
	}
}
# Konsol (DD-140, DD-148): tek adres. /api/wg/* ve /api/konsol/* root arka uca (WireGuard,
# sistem, modüller; DD-180: Unix soketi), öbür /api/* dosya arka ucuna gider. Sayfaları Caddy doğrudan sunar:
# dosya yöneticisi bir modüldür ve kaldırılabilir, Konsol'un kendisi kalmalıdır. Yalnız
# tailnet'ten; CSRF ve Host denetimi arka uçlarda (DD-147), başlıklar burada.
http://panel.__LOCAL_DOMAIN__ {
	# DD-181: sayfa dosyaları ve API yanıtları sıkıştırılır (~270 KB → ~75 KB).
	encode zstd gzip
	@kok path /api/wg/* /api/konsol/*
	handle @kok {
		reverse_proxy unix/__WG_PANEL_SOCKET__
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:__FILES_PANEL_PORT__
	}
	handle {
		root * __CONSOLE_WEB_DIR__
		header {
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			# DD-181: tarayıcı saklar ama her açılışta sorar; dosya değişmediyse 304 döner.
			Cache-Control "no-cache"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
		}
		file_server
	}
}
# Modüllerin siteleri (DD-149): master-modul buraya <id>.caddy koyar ve kaldırır (ör. Paylaşım:
# paylas. adı ve Infuse için Tailscale IP:port). Eşleşmeyen kalıp geçerlidir; nokta ile başlayan
# geçici dosyalar okunmaz. Genel seçenek bloğundan sonra gelmeli.
import __CADDY_MODULES_DIR__/*.caddy
