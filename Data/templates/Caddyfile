{
	default_bind {$TAILSCALE_IPV4}
	http_port __CADDY_HTTP_PORT__
	auto_https off
}
http://health.__LOCAL_DOMAIN__ {
	respond "ok" 200
}
http://dozzle.__LOCAL_DOMAIN__ {
	reverse_proxy 127.0.0.1:__DOZZLE_UI_PORT__
}
http://torrent.__LOCAL_DOMAIN__ {
	reverse_proxy 127.0.0.1:__TORRENT_UI_PORT__
}
# Konsol (DD-140): tek adres, iki arka uç. /api/wg/* WireGuard ve sistem arka ucuna
# (root), geri kalanı dosya arka ucuna (indirme klasörünün sahibi) gider; sayfayı da o
# verir. Yalnız tailnet'ten; giriş, CSRF ve kök denetimi arka uçlarda.
http://panel.__LOCAL_DOMAIN__ {
	handle /api/wg/* {
		reverse_proxy 127.0.0.1:__WG_PANEL_PORT__
	}
	handle {
		reverse_proxy 127.0.0.1:__FILES_PANEL_PORT__
	}
}
# Paylaşım WebDAV (DD-141): Konsol'dan paylaşılanlar; salt okunur, tek hesap.
# İkinci adres Infuse içindir (DD-98'deki nedenle): MagicDNS adını çözemeyen
# istemciler {$TAILSCALE_IPV4}:{$SHARE_PORT} ile bağlanır.
http://paylas.__LOCAL_DOMAIN__, http://{$TAILSCALE_IPV4}:{$SHARE_PORT} {
	reverse_proxy 127.0.0.1:__SHARE_PORT__
}
# Eski adresler panele yönlenir (yer imleri çalışmaya devam etsin). file. FileBrowser'ındı;
# dosyaları artık Konsol yönetir (DD-146).
http://wg.__LOCAL_DOMAIN__, http://dosya.__LOCAL_DOMAIN__, http://file.__LOCAL_DOMAIN__ {
	redir http://panel.__LOCAL_DOMAIN__{uri} 302
}
