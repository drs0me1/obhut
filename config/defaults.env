# Kurulum varsayılanları — TEK DOĞRULUK KAYNAĞI
#
# Bu dosya bir port numarasının, container adının, imaj referansının,
# path'in veya zincir adının tek kez yazıldığı yerdir. Şablonlar, firewall
# helper'ı ve state dosyası bu değerleri buradan alır.
#
# Kural: aşağıdaki bir değerin ikinci bir yerde literal olarak geçmesi
# hatadır. v1'in en büyük bakım riski aynı bilginin üç-dört yerde
# tekrarlanmasıydı (bkz. docs/architecture.md §6).
#
# Bu dosya yalnız bash tarafından source edilir; systemd EnvironmentFile
# olarak kullanılmaz (tırnaklı çok değerli satırlar systemd'de farklı
# yorumlanır).
#
# Operatörün seçtiği değerler burada DEĞİL, /etc/master-stack/config.env
# içinde tutulur. Burası varsayılanların yeri; config.env o
# varsayılanların operatör onayından geçmiş hâli.
#
# ============================================================================
# BU DOSYA GİZLİ BİLGİ İÇERMEZ VE İÇEREMEZ.
# ============================================================================
#
# Aynı yasak şu üç dosya için de geçerlidir:
#   /etc/master-stack/config.env    (operatör tercihleri)
#   /etc/master-stack/state.env     (algılanan runtime bilgileri)
#
# İzin verilen içerik yalnız şu kategorilerdir:
#   * port numaraları
#   * dizin ve dosya yolları
#   * image referansları
#   * container ve servis adları
#   * firewall zincir adları
#   * varsayılan domain önerisi
#   * WebDAV credential DOSYASININ YOLU (içeriği değil)
#
# Bu dosyada ve yukarıdaki üç dosyada asla bulunmayacak anahtarlar:
#   WEBDAV_PASSWORD
#   WEBDAV_PASSWORD_HASH
#   WEBDAV_USER_PASSWORD
#   WEBDAV_USER          (kullanıcı adı credential dosyasında yaşar; bkz. aşağı)
#
# WebDAV parolası ve kullanıcı adı ayrı, root-owned, en fazla 0600 izinli
# bir credential dosyasında tutulur; Compose webdav servisi bunu
# /run/secrets/webdav_htpasswd olarak mount eder (DD-77). Kullanıcı
# adının da orada olmasının nedeni htpasswd biçiminin zaten
# "kullanıcı:hash" tutmasıdır: adı ikinci bir dosyaya yazmak, hash ile
# sapabilecek ikinci bir doğruluk kaynağı yaratırdı.
# Ayrıntı: docs/architecture.md §4, docs/contract.md §6.
#
# ---------------------------------------------------------------- sistem
TIMEZONE="Europe/Berlin"
DOWNLOADS_PATH_DEFAULT="/downloads"
DEFAULT_LOCAL_DOMAIN="ayc"
# qBittorrent / FileBrowser / Unpackerr ortak host uid:gid (R/W)
DOWNLOADS_UID=1000
DOWNLOADS_GID=1000

# ------------------------------------------------------- public peer portlar
# WAN: wg-easy UDP; qBittorrent peer TCP+UDP (R12 / DD-63).
WG_PUBLIC_PORT="61001"
QBIT_PUBLIC_PORT="61005"

# Host SSH (MASTER-INPUT istisnası). Compose publish değil; yalnız firewall.
SSH_PUBLIC_PORT="22"

# ------------------------------------------------------- edge portları
CADDY_HTTP_PORT="80"
DNS_PORT="53"

# ------------------------------------------------------ loopback UI portları
# Yalnız 127.0.0.1 üzerinde yayınlanır; tailnet'ten erişim Caddy üzerinden.
# WebDAV Compose: 127.0.0.1:WEBDAV_PORT. Caddy: webdav.*:80 ve
# {$TAILSCALE_IPV4}:{$WEBDAV_PORT} (state.env) → loopback (Infuse).
# FileBrowser / qBit UI: 6100x tek sayı dizisi (peer/WebDAV ile aynı blok).
WEBDAV_PORT="61003"
#
# Portainer: HTTPS 9443 (DD-62, 2026-08-06). Caddy upstream self-signed
# doğrulamayı atlar (yalnız loopback). 9000 / --http-enabled kullanılmaz.
PORTAINER_UI_PORT="9443"
FILEBROWSER_UI_PORT="61007"
QBIT_UI_PORT="61006"
WG_UI_PORT="51821"

# ------------------------------------------------------------- container'lar
# Compose imajları (DD-97): upstream'in yayınladığı kararlı hat tag'i.
# sts / edge / nightly / beta yasak. İsim olarak `latest` yalnız LinuxServer
# qBittorrent'te geçerli — orada anlamı "stable + libtorrent v2" (dokümantasyon).
# Portainer `lts` resmi LTS track'i.
PORTAINER_IMAGE="portainer/portainer-ce:lts"
# Klasik filebrowser (hacdias). Maintenance-only / Eyl 2026 arşiv riski bilinçli
# (DD-92); --disableExec ile bilinen shell yüzeyi kapalı. Quantum değil.
FILEBROWSER_IMAGE="filebrowser/filebrowser:v2"
# LinuxServer: latest = stable qBittorrent + libtorrent v2 (libtorrentv1 ayrı hat).
QBITTORRENT_IMAGE="lscr.io/linuxserver/qbittorrent:latest"
WG_EASY_IMAGE="ghcr.io/wg-easy/wg-easy:15"
UNPACKERR_IMAGE="ghcr.io/unpackerr/unpackerr:0.15"
RCLONE_IMAGE="rclone/rclone:1.75"

# Konteyner log rotasyonu (DD-107). json-file sürücüsünün varsayılanı
# sınırsızdır; altı `restart: unless-stopped` servisin biri torrent istemcisi.
# daemon.json'a yazılır ve YALNIZ bundan sonra OLUŞTURULAN konteynerleri
# etkiler — mevcut host'ta compose yeniden yaratana kadar yürürlüğe girmez.
DOCKER_LOG_MAX_SIZE="10m"
DOCKER_LOG_MAX_FILE="3"

# --------------------------------------------------------- servis adları
# dnsmasq kaydı ve Caddy site bloğu bu tek listeden üretilir. Bir ad
# yalnız birinde varsa bu bir hatadır (N4 testi).
SERVICE_NAMES="portainer wg qbit file webdav health"

# ----------------------------------------------------------------- ağ
# Adres isimleri (state.env):
#   WAN_INTERFACE, WAN_IPV4  — ip route get ile bulunan yerel WAN (public IP olmak zorunda değil)
#   TAILSCALE_IPV4, TAILSCALE_IPV6
#   WG_ENDPOINT_HOST         — state'te WAN_IPV4 ile doldurulur (sorulmaz; özet ipucu;
#                              Compose .env'e yazılmaz)
# PUBLIC_IPV4 adı kullanılmaz.
TAILSCALE_IF="tailscale0"

# tailscaled'in dinlediği UDP portu (Debian paketi --port=41641 ile başlatır).
# MASTER-INPUT bunu kendisi kabul eder; aksi hâlde doğrudan peer bağlantısı
# yalnız ts-input'un var olmasına ve INPUT'ta önde durmasına bağlı kalırdı.
# ts-input hâlâ kendi kuralını koyar; buradaki kural onu değiştirmez (DD-73).
TAILSCALE_UDP_PORT="41641"

# wg-easy sabit bridge (WAN IP gömülmez; yalnız container ağı)
WG_BRIDGE_SUBNET="10.42.42.0/24"
WG_BRIDGE_IPV4="10.42.42.42"
WG_BRIDGE_SUBNET6="fdcc:ad94:bacf:61a3::/64"
WG_BRIDGE_IPV6="fdcc:ad94:bacf:61a3::2a"

# UDP soket buffer tabanı (DD-18): Tailscale/wireguard-go için floor.
# Mevcut sysctl daha yüksekse düşürülmez. Tailscale paketinden ÖNCE yazılır.
NET_BUF_FLOOR_BYTES=16777216

# Firewall zincirleri (DD-59). Kesin isimler bunlar; MASTER-DOCKER-FILTER
# kullanılmıyor. MASTER-INPUT bu kurulumda var — eski yapıda host INPUT politikası hiç
# yoktu. Aynı mantıksal isimler IPv4 ve IPv6 için kullanılır; tablolar
# ayrı olduğu için çakışmazlar.
#
# Bu iki isim yalnız burada tanımlanır. Bir zincir adının ikinci bir
# dosyada literal olarak geçmesi hatadır.
CHAIN_INPUT="MASTER-INPUT"
CHAIN_DOCKER="MASTER-DOCKER"

# Staging zinciri öneki: kurallar önce burada kurulur, sonra atomik
# devreye alınır (karar 22).
CHAIN_STAGING_PREFIX="MASTER-NEXT-"

# ------------------------------------------------------------ host path'ler
STATE_DIR="/etc/master-stack"
CONFIG_FILE="/etc/master-stack/config.env"
STATE_FILE="/etc/master-stack/state.env"
WEBDAV_HTPASSWD_FILE="/etc/master-stack/webdav.htpasswd"
# Klasik FileBrowser Bolt DB (uid DOWNLOADS_*). Quantum YAML yok (DD-92).
FILEBROWSER_DATA_DIR="/etc/master-stack/filebrowser-data"
COMPOSE_DIR="/root/docker"
DNSMASQ_CONF_FILE="/etc/dnsmasq.d/local-services.conf"
CADDYFILE="/etc/caddy/Caddyfile"
SBIN_DIR="/usr/local/sbin"
UNIT_DIR="/etc/systemd/system"
RUNTIME_DIR="/run/master-stack"
LOG_DIR="/var/log/master-setup"

# sysctl drop-in'leri (DD-105). /etc/sysctl.d sözlüksel sırayla uygulanır ve
# SON atama kazanır. Sağlayıcı imajları da 99-*.conf bırakır (netcup:
# 99-nc-kernel.conf, rmem/wmem yazar); "zz" öneki master-stack'in en sonda
# kalmasını garanti eder. Aksi hâlde ip_forward boot'ta sessizce geri alınabilir.
SYSCTL_NETBUF_FILE="/etc/sysctl.d/99-zz-master-stack-netbuf.conf"
SYSCTL_FORWARD_FILE="/etc/sysctl.d/99-zz-master-tailscale.conf"
# v2-73 ve öncesinin adları; yükseltmede silinir (iki dosya çift yazmasın).
SYSCTL_LEGACY_FILES="/etc/sysctl.d/99-master-stack-netbuf.conf /etc/sysctl.d/99-master-tailscale.conf"

# ------------------------------------------------------------- zaman aşımı
# Her bekleme duvar saatiyle sınırlıdır; hiçbir yerde iterasyon sayısı bir
# süre vaadi olarak kullanılmaz (wait_deadlines meta-testi).
LOCK_WAIT_SECONDS=5
APT_LOCK_TIMEOUT=300
TS_ONLINE_DEADLINE_SECONDS=120

# Opt-in imaj pull'u öncesi /var/lib/docker dosya sisteminde istenen asgari
# boş alan (GiB). Altındaysa pull hiç başlamaz — fail-closed (DD-101).
PULL_MIN_FREE_GB=5

# --------------------------------------------------------------- WebDAV
# Compose servisi (rclone imajı). Kullanıcı adı/parola yalnız
# WEBDAV_HTPASSWD_FILE içinde. Salt-okunurluk sabit: --read-only + :ro mount.
WEBDAV_MIN_PASSWORD_LENGTH=8
